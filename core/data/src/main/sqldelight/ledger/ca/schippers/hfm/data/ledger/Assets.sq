-- Assets, warranties and insurance (AST-01 to AST-05, WAR-01 to WAR-04, INS-01 to INS-05), kept in
-- the ledger of the account group the user chooses (HH-11).

-- AST-01 to AST-05: the home, appliances, RV, boat and everything else worth keeping track of
-- (vehicles have their own tables). [parent_id] puts a furnace in its house (AST-02). The value is
-- entered ([value_minor] on [value_date]) or worked out from the price, falling evenly to
-- [residual_percent] over [depreciation_years] (AST-03); [in_net_worth] counts it in net worth.
CREATE TABLE asset (
    id TEXT NOT NULL PRIMARY KEY,
    parent_id TEXT,
    kind TEXT NOT NULL,
    name TEXT NOT NULL,
    make TEXT,
    model TEXT,
    serial_number TEXT,
    purchase_date TEXT,
    seller TEXT,
    purchase_price_minor INTEGER,
    currency TEXT NOT NULL DEFAULT 'CAD',
    txn_id TEXT,
    location TEXT,
    owner_member_id TEXT,
    value_method TEXT NOT NULL DEFAULT 'NONE' CHECK (value_method IN ('NONE', 'MANUAL', 'DEPRECIATION')),
    value_minor INTEGER,
    value_date TEXT,
    depreciation_years INTEGER,
    residual_percent TEXT,
    in_net_worth INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'SOLD', 'GIVEN_AWAY', 'DISCARDED')),
    disposal_date TEXT,
    disposal_price_minor INTEGER,
    disposal_txn_id TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    -- MNT-03: what its meter counts, if it has one: HOURS or KM.
    meter TEXT
);

CREATE INDEX asset_parent ON asset(parent_id);

-- WAR-01: a warranty or service plan for an asset or a vehicle ([asset_id] is either). A card's
-- extended warranty names the card account; its months come from the card's benefit (CC-04).
CREATE TABLE warranty (
    id TEXT NOT NULL PRIMARY KEY,
    asset_id TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('MANUFACTURER', 'EXTENDED', 'CARD_EXTENDED', 'SERVICE_CONTRACT', 'OTHER')),
    provider TEXT,
    coverage TEXT,
    start_date TEXT,
    end_date TEXT,
    end_hours INTEGER,
    phone TEXT,
    card_account_id TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX warranty_asset ON warranty(asset_id);

-- WAR-03: each claim made under a warranty.
CREATE TABLE warranty_claim (
    id TEXT NOT NULL PRIMARY KEY,
    warranty_id TEXT NOT NULL REFERENCES warranty(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    problem TEXT NOT NULL,
    outcome TEXT,
    covered_minor INTEGER,
    paid_minor INTEGER,
    notes TEXT
);

-- INS-01: an insurance policy, with its premium, deductible, coverage and renewal.
CREATE TABLE insurance_policy (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    insurer TEXT NOT NULL,
    broker TEXT,
    policy_number TEXT,
    insured_member_id TEXT,
    premium_minor INTEGER,
    premium_frequency TEXT NOT NULL DEFAULT 'ANNUAL' CHECK (premium_frequency IN ('MONTHLY', 'QUARTERLY', 'SEMI_ANNUAL', 'ANNUAL')),
    deductible_minor INTEGER,
    coverage_minor INTEGER,
    coverage_notes TEXT,
    start_date TEXT,
    renewal_date TEXT,
    active INTEGER NOT NULL DEFAULT 1,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- INS-02: the assets and vehicles a policy covers.
CREATE TABLE policy_asset (
    policy_id TEXT NOT NULL REFERENCES insurance_policy(id) ON DELETE CASCADE,
    asset_id TEXT NOT NULL,
    PRIMARY KEY (policy_id, asset_id)
);

-- INS-03: the premium of each term, year over year.
CREATE TABLE policy_premium (
    id TEXT NOT NULL PRIMARY KEY,
    policy_id TEXT NOT NULL REFERENCES insurance_policy(id) ON DELETE CASCADE,
    start_date TEXT NOT NULL,
    premium_minor INTEGER NOT NULL,
    notes TEXT
);

-- INS-05: who receives a life policy's benefit, and their share.
CREATE TABLE policy_beneficiary (
    id TEXT NOT NULL PRIMARY KEY,
    policy_id TEXT NOT NULL REFERENCES insurance_policy(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    member_id TEXT,
    relationship TEXT,
    share_percent TEXT,
    contingent INTEGER NOT NULL DEFAULT 0
);

-- INS-04: a claim on a policy (not medical), with the amounts and the payout.
CREATE TABLE insurance_claim (
    id TEXT NOT NULL PRIMARY KEY,
    policy_id TEXT NOT NULL REFERENCES insurance_policy(id) ON DELETE CASCADE,
    asset_id TEXT,
    date TEXT NOT NULL,
    description TEXT NOT NULL,
    claim_number TEXT,
    status TEXT NOT NULL DEFAULT 'OPEN' CHECK (status IN ('OPEN', 'PAID', 'DENIED', 'CLOSED')),
    claimed_minor INTEGER,
    deductible_minor INTEGER,
    paid_minor INTEGER,
    paid_date TEXT,
    txn_id TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

upsertAsset:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, everything that belongs to it.
INSERT INTO asset(id, parent_id, kind, name, make, model, serial_number, purchase_date, seller, purchase_price_minor, currency, txn_id, location,
    owner_member_id, value_method, value_minor, value_date, depreciation_years, residual_percent, in_net_worth, status, disposal_date, disposal_price_minor,
    disposal_txn_id, notes, created_at, updated_at, meter)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    parent_id = excluded.parent_id,
    kind = excluded.kind,
    name = excluded.name,
    make = excluded.make,
    model = excluded.model,
    serial_number = excluded.serial_number,
    purchase_date = excluded.purchase_date,
    seller = excluded.seller,
    purchase_price_minor = excluded.purchase_price_minor,
    currency = excluded.currency,
    txn_id = excluded.txn_id,
    location = excluded.location,
    owner_member_id = excluded.owner_member_id,
    value_method = excluded.value_method,
    value_minor = excluded.value_minor,
    value_date = excluded.value_date,
    depreciation_years = excluded.depreciation_years,
    residual_percent = excluded.residual_percent,
    in_net_worth = excluded.in_net_worth,
    status = excluded.status,
    disposal_date = excluded.disposal_date,
    disposal_price_minor = excluded.disposal_price_minor,
    disposal_txn_id = excluded.disposal_txn_id,
    notes = excluded.notes,
    created_at = excluded.created_at,
    updated_at = excluded.updated_at,
    meter = excluded.meter;

assets:
SELECT * FROM asset ORDER BY name;

assetById:
SELECT * FROM asset WHERE id = ?;

deleteAsset:
DELETE FROM asset WHERE id = ?;

childCount:
SELECT count(*) FROM asset WHERE parent_id = ?;

upsertWarranty:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, everything that belongs to it.
INSERT INTO warranty(id, asset_id, kind, provider, coverage, start_date, end_date, end_hours, phone, card_account_id, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    asset_id = excluded.asset_id,
    kind = excluded.kind,
    provider = excluded.provider,
    coverage = excluded.coverage,
    start_date = excluded.start_date,
    end_date = excluded.end_date,
    end_hours = excluded.end_hours,
    phone = excluded.phone,
    card_account_id = excluded.card_account_id,
    notes = excluded.notes,
    created_at = excluded.created_at,
    updated_at = excluded.updated_at;

warranties:
SELECT * FROM warranty ORDER BY end_date;

warrantyById:
SELECT * FROM warranty WHERE id = ?;

deleteWarranty:
DELETE FROM warranty WHERE id = ?;

upsertWarrantyClaim:
INSERT OR REPLACE INTO warranty_claim(id, warranty_id, date, problem, outcome, covered_minor, paid_minor, notes) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

warrantyClaims:
SELECT * FROM warranty_claim WHERE warranty_id = ? ORDER BY date DESC;

deleteWarrantyClaim:
DELETE FROM warranty_claim WHERE id = ?;

upsertPolicy:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, everything that belongs to it.
INSERT INTO insurance_policy(id, kind, insurer, broker, policy_number, insured_member_id, premium_minor, premium_frequency, deductible_minor, coverage_minor,
    coverage_notes, start_date, renewal_date, active, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    kind = excluded.kind,
    insurer = excluded.insurer,
    broker = excluded.broker,
    policy_number = excluded.policy_number,
    insured_member_id = excluded.insured_member_id,
    premium_minor = excluded.premium_minor,
    premium_frequency = excluded.premium_frequency,
    deductible_minor = excluded.deductible_minor,
    coverage_minor = excluded.coverage_minor,
    coverage_notes = excluded.coverage_notes,
    start_date = excluded.start_date,
    renewal_date = excluded.renewal_date,
    active = excluded.active,
    notes = excluded.notes,
    created_at = excluded.created_at,
    updated_at = excluded.updated_at;

policies:
SELECT * FROM insurance_policy ORDER BY kind, insurer;

policyById:
SELECT * FROM insurance_policy WHERE id = ?;

deletePolicy:
DELETE FROM insurance_policy WHERE id = ?;

policyAssets:
SELECT asset_id FROM policy_asset WHERE policy_id = ?;

allPolicyAssets:
SELECT * FROM policy_asset;

clearPolicyAssets:
DELETE FROM policy_asset WHERE policy_id = ?;

addPolicyAsset:
INSERT OR REPLACE INTO policy_asset(policy_id, asset_id) VALUES (?, ?);

premiums:
SELECT * FROM policy_premium WHERE policy_id = ? ORDER BY start_date DESC;

upsertPremium:
INSERT OR REPLACE INTO policy_premium(id, policy_id, start_date, premium_minor, notes) VALUES (?, ?, ?, ?, ?);

deletePremium:
DELETE FROM policy_premium WHERE id = ?;

beneficiaries:
SELECT * FROM policy_beneficiary WHERE policy_id = ? ORDER BY contingent, name;

upsertBeneficiary:
INSERT OR REPLACE INTO policy_beneficiary(id, policy_id, name, member_id, relationship, share_percent, contingent) VALUES (?, ?, ?, ?, ?, ?, ?);

deleteBeneficiary:
DELETE FROM policy_beneficiary WHERE id = ?;

claims:
SELECT * FROM insurance_claim ORDER BY date DESC;

claimById:
SELECT * FROM insurance_claim WHERE id = ?;

upsertClaim:
INSERT OR REPLACE INTO insurance_claim(id, policy_id, asset_id, date, description, claim_number, status, claimed_minor, deductible_minor, paid_minor, paid_date, txn_id, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteClaim:
DELETE FROM insurance_claim WHERE id = ?;
