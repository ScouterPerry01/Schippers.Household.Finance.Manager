-- Health records per household member (HLT-01 to HLT-07). Stored in the ledger of the account
-- group the user chooses, so a private group keeps them encrypted from other users (CAL-06).

CREATE TABLE health_provider (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('DOCTOR', 'DENTIST', 'PHARMACY', 'CLINIC', 'HOSPITAL', 'SPECIALIST', 'LAB', 'OTHER')),
    phone TEXT,
    address TEXT,
    notes TEXT,
    archived INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE medication (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    name TEXT NOT NULL,
    dose TEXT,
    instructions TEXT,
    prescriber_id TEXT,
    pharmacy_id TEXT,
    rx_number TEXT,
    start_date TEXT,
    end_date TEXT,
    -- HLT-02: days one fill lasts, refills left on the prescription, and the last fill.
    days_supply INTEGER,
    refills_remaining INTEGER,
    last_fill_date TEXT,
    refill_reminder_days INTEGER NOT NULL DEFAULT 5,
    active INTEGER NOT NULL DEFAULT 1,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE medication_fill (
    id TEXT NOT NULL PRIMARY KEY,
    medication_id TEXT NOT NULL REFERENCES medication(id) ON DELETE CASCADE,
    fill_date TEXT NOT NULL,
    days_supply INTEGER,
    quantity TEXT,
    notes TEXT
);

CREATE TABLE health_condition (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    name TEXT NOT NULL,
    diagnosed_date TEXT,
    status TEXT NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'MANAGED', 'RESOLVED')),
    provider_id TEXT,
    notes TEXT
);

CREATE TABLE allergy (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    substance TEXT NOT NULL,
    reaction TEXT,
    severity TEXT CHECK (severity IN ('MILD', 'MODERATE', 'SEVERE')),
    notes TEXT
);

CREATE TABLE health_test (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    name TEXT NOT NULL,
    date TEXT NOT NULL,
    result TEXT,
    units TEXT,
    reference_range TEXT,
    provider_id TEXT,
    follow_up_date TEXT,
    notes TEXT
);

CREATE TABLE immunization (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    vaccine TEXT NOT NULL,
    date TEXT NOT NULL,
    provider_id TEXT,
    next_due_date TEXT,
    notes TEXT
);

-- Providers --------------------------------------------------------------------------------

upsertProvider:
INSERT OR REPLACE INTO health_provider(id, name, kind, phone, address, notes, archived) VALUES (?, ?, ?, ?, ?, ?, ?);

providers:
SELECT * FROM health_provider ORDER BY name COLLATE NOCASE;

-- Medications ------------------------------------------------------------------------------

insertMedication:
INSERT INTO medication(id, member_id, name, dose, instructions, prescriber_id, pharmacy_id, rx_number, start_date, end_date,
    days_supply, refills_remaining, last_fill_date, refill_reminder_days, active, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateMedication:
UPDATE medication SET member_id = ?, name = ?, dose = ?, instructions = ?, prescriber_id = ?, pharmacy_id = ?, rx_number = ?,
    start_date = ?, end_date = ?, days_supply = ?, refills_remaining = ?, last_fill_date = ?, refill_reminder_days = ?,
    active = ?, notes = ?, updated_at = ?
WHERE id = ?;

deleteMedication:
DELETE FROM medication WHERE id = ?;

medications:
SELECT * FROM medication ORDER BY active DESC, name COLLATE NOCASE;

medicationById:
SELECT * FROM medication WHERE id = ?;

insertFill:
INSERT INTO medication_fill(id, medication_id, fill_date, days_supply, quantity, notes) VALUES (?, ?, ?, ?, ?, ?);

fillsFor:
SELECT * FROM medication_fill WHERE medication_id = ? ORDER BY fill_date DESC;

-- Conditions, allergies, tests, immunizations ----------------------------------------------

upsertCondition:
INSERT OR REPLACE INTO health_condition(id, member_id, name, diagnosed_date, status, provider_id, notes) VALUES (?, ?, ?, ?, ?, ?, ?);

conditions:
SELECT * FROM health_condition ORDER BY status, name COLLATE NOCASE;

deleteCondition:
DELETE FROM health_condition WHERE id = ?;

upsertAllergy:
INSERT OR REPLACE INTO allergy(id, member_id, substance, reaction, severity, notes) VALUES (?, ?, ?, ?, ?, ?);

allergies:
SELECT * FROM allergy ORDER BY substance COLLATE NOCASE;

deleteAllergy:
DELETE FROM allergy WHERE id = ?;

upsertTest:
INSERT OR REPLACE INTO health_test(id, member_id, name, date, result, units, reference_range, provider_id, follow_up_date, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

tests:
SELECT * FROM health_test ORDER BY date DESC;

deleteTest:
DELETE FROM health_test WHERE id = ?;

upsertImmunization:
INSERT OR REPLACE INTO immunization(id, member_id, vaccine, date, provider_id, next_due_date, notes) VALUES (?, ?, ?, ?, ?, ?, ?);

immunizations:
SELECT * FROM immunization ORDER BY date DESC;

deleteImmunization:
DELETE FROM immunization WHERE id = ?;
