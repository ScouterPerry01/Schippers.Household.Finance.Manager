-- EST-01, EST-02 (ledger version 23): where a person's will, powers of attorney, mandate and safe
-- deposit box are, who to call, and their wishes; kept as JSON so the form can grow. One per person.
CREATE TABLE estate_record (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL UNIQUE,
    plan TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

estateRecords:
SELECT * FROM estate_record;

upsertEstateRecord:
INSERT INTO estate_record(id, member_id, plan, updated_at) VALUES (?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET plan = excluded.plan, updated_at = excluded.updated_at;

deleteEstateRecord:
DELETE FROM estate_record WHERE id = ?;
