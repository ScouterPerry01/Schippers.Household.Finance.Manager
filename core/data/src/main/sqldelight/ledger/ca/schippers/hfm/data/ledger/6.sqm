-- Version 6 to 7 (INV-09 to INV-11): registered plan details, beneficiaries, contribution room,
-- RESP grants and pensions.

CREATE TABLE registered_plan (
    account_id TEXT NOT NULL PRIMARY KEY REFERENCES account(id) ON DELETE CASCADE,
    contributor_member_id TEXT,
    minimum_age_member_id TEXT,
    lif_reference_rate TEXT,
    notes TEXT
);

CREATE TABLE plan_beneficiary (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    kind TEXT NOT NULL CHECK (kind IN ('BENEFICIARY', 'SUCCESSOR_HOLDER', 'RESP_BENEFICIARY')),
    member_id TEXT,
    name TEXT NOT NULL,
    relationship TEXT,
    share_percent TEXT,
    notes TEXT
);

CREATE INDEX plan_beneficiary_account ON plan_beneficiary(account_id);

CREATE TABLE plan_value (
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    year INTEGER NOT NULL,
    value_minor INTEGER NOT NULL,
    last_year_earnings_minor INTEGER,
    PRIMARY KEY (account_id, year)
);

CREATE TABLE room_entry (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    plan TEXT NOT NULL CHECK (plan IN ('RRSP', 'TFSA', 'FHSA')),
    year INTEGER NOT NULL,
    limit_minor INTEGER NOT NULL,
    unused_minor INTEGER NOT NULL DEFAULT 0,
    notes TEXT
);

CREATE UNIQUE INDEX room_entry_key ON room_entry(member_id, plan, year);

CREATE TABLE room_adjustment (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    plan TEXT NOT NULL CHECK (plan IN ('RRSP', 'TFSA', 'FHSA')),
    date TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    notes TEXT
);

CREATE TABLE resp_grant (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    member_id TEXT NOT NULL,
    date TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('CESG', 'QESI', 'CLB', 'OTHER')),
    amount_minor INTEGER NOT NULL,
    txn_id TEXT,
    notes TEXT
);

CREATE INDEX resp_grant_account ON resp_grant(account_id, date);

CREATE TABLE pension (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('DEFINED_BENEFIT', 'DEFINED_CONTRIBUTION', 'QPP', 'CPP', 'OAS', 'OTHER')),
    name TEXT NOT NULL,
    administrator TEXT,
    member_number TEXT,
    start_date TEXT,
    normal_retirement_age INTEGER,
    indexed INTEGER NOT NULL DEFAULT 0,
    survivor_percent TEXT,
    account_id TEXT,
    payer TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE pension_statement (
    id TEXT NOT NULL PRIMARY KEY,
    pension_id TEXT NOT NULL REFERENCES pension(id) ON DELETE CASCADE,
    year INTEGER NOT NULL,
    pension_adjustment_minor INTEGER,
    accrued_annual_minor INTEGER,
    projected_annual_minor INTEGER,
    value_minor INTEGER,
    contributions_minor INTEGER,
    notes TEXT
);

CREATE INDEX pension_statement_pension ON pension_statement(pension_id, year);
