-- INV-08: T5, T3, RL-3 and RL-16 slips entered by hand, kept with the account that received the
-- income (HH-11). A slip entered replaces the estimate from the books for the same account, year,
-- kind and fund.
CREATE TABLE tax_slip (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    year INTEGER NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('T5', 'T3', 'RL3', 'RL16')),
    -- The fund a T3 or RL-16 is for; empty for a slip covering the whole account.
    security_id TEXT NOT NULL DEFAULT '',
    -- JSON map of box code to amount in dollars, as printed on the slip.
    boxes TEXT NOT NULL,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE UNIQUE INDEX tax_slip_key ON tax_slip(account_id, year, kind, security_id);

upsertSlip:
INSERT OR REPLACE INTO tax_slip(id, account_id, year, kind, security_id, boxes, notes, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

slipsForYear:
SELECT * FROM tax_slip WHERE year = ? ORDER BY account_id, kind, security_id;

slipByKey:
SELECT * FROM tax_slip WHERE account_id = ? AND year = ? AND kind = ? AND security_id = ?;

deleteSlip:
DELETE FROM tax_slip WHERE id = ?;
