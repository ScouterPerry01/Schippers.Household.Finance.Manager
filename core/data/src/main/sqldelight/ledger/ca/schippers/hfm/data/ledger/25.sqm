-- Version 25 to 26: a donation receipt for each gift within a payment (M-43), and a loan renewal's
-- previous term end in its own columns (M-30). Only additions: existing receipts stay as they are.

ALTER TABLE loan_change ADD COLUMN renewal INTEGER NOT NULL DEFAULT 0;
ALTER TABLE loan_change ADD COLUMN previous_term_end TEXT;

CREATE TABLE donation_receipt (
    txn_id TEXT NOT NULL REFERENCES txn(id) ON DELETE CASCADE,
    member_key TEXT NOT NULL,
    kind TEXT NOT NULL,
    charity TEXT,
    registration TEXT,
    receipt_number TEXT,
    eligible_minor INTEGER,
    received INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (txn_id, member_key, kind)
);
