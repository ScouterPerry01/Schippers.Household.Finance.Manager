-- Medical and dental plans, expenses and claims (MED-01 to MED-15). Kept in the ledger of the
-- account group the user chooses, as for health records, so private ones stay private (HH-11).

-- MED-01, MED-03: a health, dental, vision, travel or public plan. [member_id] is the plan member;
-- the plan year starts on [year_start_month]/[year_start_day]; claims are due [claim_days] after the
-- service (MED-09). A Health Spending Account has a yearly credit, [hsa_amount_minor].
CREATE TABLE med_plan (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL CHECK (kind IN ('GROUP_HEALTH', 'DENTAL', 'VISION', 'PRIVATE_HEALTH', 'TRAVEL', 'HSA', 'RAMQ', 'CDCP', 'OTHER')),
    name TEXT NOT NULL,
    insurer TEXT,
    policy_number TEXT,
    certificate_number TEXT,
    member_id TEXT,
    year_start_month INTEGER NOT NULL DEFAULT 1,
    year_start_day INTEGER NOT NULL DEFAULT 1,
    claim_days INTEGER NOT NULL DEFAULT 365,
    hsa_amount_minor INTEGER,
    active INTEGER NOT NULL DEFAULT 1,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- MED-01: the people a plan covers, and in what order it pays for each (1 = first: coordination
-- of benefits between spouses' plans).
CREATE TABLE med_plan_person (
    plan_id TEXT NOT NULL REFERENCES med_plan(id) ON DELETE CASCADE,
    member_id TEXT NOT NULL,
    priority INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (plan_id, member_id)
);

-- MED-02: what a plan pays for one kind of service.
CREATE TABLE med_coverage (
    id TEXT NOT NULL PRIMARY KEY,
    plan_id TEXT NOT NULL REFERENCES med_plan(id) ON DELETE CASCADE,
    service TEXT NOT NULL,
    percent TEXT NOT NULL,
    deductible_minor INTEGER,
    annual_max_minor INTEGER,
    per_visit_max_minor INTEGER,
    frequency_months INTEGER,
    notes TEXT
);

CREATE INDEX med_coverage_plan ON med_coverage(plan_id);

-- MED-06: one medical or dental expense, with the transaction that paid it and, for a
-- prescription, the medication (HLT-08). [paid_date] is when it was paid, for the tax credit.
CREATE TABLE med_expense (
    id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    provider_id TEXT,
    service TEXT NOT NULL,
    service_date TEXT NOT NULL,
    paid_date TEXT,
    description TEXT,
    amount_minor INTEGER NOT NULL,
    transaction_id TEXT,
    medication_id TEXT,
    tax_eligible INTEGER NOT NULL DEFAULT 1,
    closed INTEGER NOT NULL DEFAULT 0,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX med_expense_date ON med_expense(service_date);
CREATE INDEX med_expense_txn ON med_expense(transaction_id) WHERE transaction_id IS NOT NULL;

-- MED-07: an expense claimed to one plan, with the amounts at each stage.
CREATE TABLE med_claim (
    id TEXT NOT NULL PRIMARY KEY,
    expense_id TEXT NOT NULL REFERENCES med_expense(id) ON DELETE CASCADE,
    plan_id TEXT NOT NULL,
    status TEXT NOT NULL CHECK (status IN ('SUBMITTED', 'PAID', 'DENIED')),
    submitted_date TEXT NOT NULL,
    claimed_minor INTEGER NOT NULL,
    paid_date TEXT,
    paid_minor INTEGER,
    reference TEXT,
    transaction_id TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX med_claim_expense ON med_claim(expense_id);

upsertPlan:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, everything that belongs to it.
INSERT INTO med_plan(id, kind, name, insurer, policy_number, certificate_number, member_id, year_start_month, year_start_day, claim_days, hsa_amount_minor, active, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    kind = excluded.kind,
    name = excluded.name,
    insurer = excluded.insurer,
    policy_number = excluded.policy_number,
    certificate_number = excluded.certificate_number,
    member_id = excluded.member_id,
    year_start_month = excluded.year_start_month,
    year_start_day = excluded.year_start_day,
    claim_days = excluded.claim_days,
    hsa_amount_minor = excluded.hsa_amount_minor,
    active = excluded.active,
    notes = excluded.notes,
    created_at = excluded.created_at,
    updated_at = excluded.updated_at;

plans:
SELECT * FROM med_plan ORDER BY name;

planById:
SELECT * FROM med_plan WHERE id = ?;

deletePlan:
DELETE FROM med_plan WHERE id = ?;

planPeople:
SELECT * FROM med_plan_person WHERE plan_id = ? ORDER BY priority;

clearPlanPeople:
DELETE FROM med_plan_person WHERE plan_id = ?;

addPlanPerson:
INSERT OR REPLACE INTO med_plan_person(plan_id, member_id, priority) VALUES (?, ?, ?);

coverages:
SELECT * FROM med_coverage WHERE plan_id = ? ORDER BY service;

upsertCoverage:
INSERT OR REPLACE INTO med_coverage(id, plan_id, service, percent, deductible_minor, annual_max_minor, per_visit_max_minor, frequency_months, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteCoverage:
DELETE FROM med_coverage WHERE id = ?;

upsertExpense:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, everything that belongs to it.
INSERT INTO med_expense(id, member_id, provider_id, service, service_date, paid_date, description, amount_minor, transaction_id, medication_id, tax_eligible, closed, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    member_id = excluded.member_id,
    provider_id = excluded.provider_id,
    service = excluded.service,
    service_date = excluded.service_date,
    paid_date = excluded.paid_date,
    description = excluded.description,
    amount_minor = excluded.amount_minor,
    transaction_id = excluded.transaction_id,
    medication_id = excluded.medication_id,
    tax_eligible = excluded.tax_eligible,
    closed = excluded.closed,
    notes = excluded.notes,
    created_at = excluded.created_at,
    updated_at = excluded.updated_at;

expenses:
SELECT * FROM med_expense ORDER BY service_date DESC, created_at DESC;

expenseById:
SELECT * FROM med_expense WHERE id = ?;

deleteExpense:
DELETE FROM med_expense WHERE id = ?;

setExpenseClosed:
UPDATE med_expense SET closed = ?, updated_at = ? WHERE id = ?;

linkedTransactions:
SELECT transaction_id FROM med_expense WHERE transaction_id IS NOT NULL;

claims:
SELECT * FROM med_claim ORDER BY submitted_date;

claimsForExpense:
SELECT * FROM med_claim WHERE expense_id = ? ORDER BY submitted_date, created_at;

claimById:
SELECT * FROM med_claim WHERE id = ?;

upsertClaim:
INSERT OR REPLACE INTO med_claim(id, expense_id, plan_id, status, submitted_date, claimed_minor, paid_date, paid_minor, reference, transaction_id, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteClaim:
DELETE FROM med_claim WHERE id = ?;
