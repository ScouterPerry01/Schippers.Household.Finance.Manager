-- Version 29 to 30. Only additions: new columns with defaults and new tables.

-- MED-09: how a medical plan's claim deadline is counted: AFTER_SERVICE (claim_days after the date
-- of service, as before) or AFTER_PLAN_YEAR (claim_days after the plan year of the service ends;
-- 0 = by the last day of the plan year).
ALTER TABLE med_plan ADD COLUMN claim_rule TEXT NOT NULL DEFAULT 'AFTER_SERVICE';
