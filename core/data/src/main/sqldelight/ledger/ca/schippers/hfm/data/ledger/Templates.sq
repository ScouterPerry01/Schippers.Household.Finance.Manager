-- MAN-05 (version 30): named transaction templates, picked in a register's entry form, kept in
-- the ledger of the group they belong to. [account_id] limits a template to one account; the amount
-- (signed, in [currency]) is optional; [tags] holds tag names, one per line.
CREATE TABLE txn_template (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    payee TEXT,
    memo TEXT,
    amount_minor INTEGER,
    currency TEXT,
    account_id TEXT,
    member_id TEXT,
    tags TEXT NOT NULL DEFAULT '',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- A template's category, or its split lines in order (each with its amount when there are several).
CREATE TABLE txn_template_line (
    template_id TEXT NOT NULL REFERENCES txn_template(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    category_id TEXT,
    amount_minor INTEGER,
    memo TEXT,
    PRIMARY KEY (template_id, position)
);

upsertTemplate:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, its lines.
INSERT INTO txn_template(id, name, payee, memo, amount_minor, currency, account_id, member_id, tags, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    name = excluded.name,
    payee = excluded.payee,
    memo = excluded.memo,
    amount_minor = excluded.amount_minor,
    currency = excluded.currency,
    account_id = excluded.account_id,
    member_id = excluded.member_id,
    tags = excluded.tags,
    updated_at = excluded.updated_at;

templates:
SELECT * FROM txn_template ORDER BY name COLLATE NOCASE;

templateById:
SELECT * FROM txn_template WHERE id = ?;

deleteTemplate:
DELETE FROM txn_template WHERE id = ?;

templateLines:
SELECT * FROM txn_template_line WHERE template_id = ? ORDER BY position;

clearTemplateLines:
DELETE FROM txn_template_line WHERE template_id = ?;

insertTemplateLine:
INSERT INTO txn_template_line(template_id, position, category_id, amount_minor, memo) VALUES (?, ?, ?, ?, ?);
