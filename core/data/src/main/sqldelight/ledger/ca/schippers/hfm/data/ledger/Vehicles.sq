-- Vehicles (VEH-01 to VEH-11): details, renewals, warranties, odometer, maintenance schedule,
-- service and fuel logs. Amounts are in the vehicle's currency, in minor units.

CREATE TABLE vehicle (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    make TEXT,
    model TEXT,
    model_year INTEGER,
    trim_level TEXT,
    colour TEXT,
    vin TEXT,
    plate TEXT,
    fuel_type TEXT NOT NULL DEFAULT 'GASOLINE' CHECK (fuel_type IN ('GASOLINE', 'DIESEL', 'HYBRID', 'PLUG_IN_HYBRID', 'ELECTRIC', 'OTHER')),
    driver_member_id TEXT,
    purchase_date TEXT,
    purchase_price_minor INTEGER,
    seller TEXT,
    purchase_odometer INTEGER,
    currency TEXT NOT NULL DEFAULT 'CAD',
    registration_renewal TEXT,
    insurer TEXT,
    policy_number TEXT,
    insurance_renewal TEXT,
    status TEXT NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'SOLD', 'RETIRED')),
    disposal_date TEXT,
    disposal_price_minor INTEGER,
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    -- SAL-03 (version 30): the sale deposit in the books; its payee is the buyer.
    disposal_txn_id TEXT
);

-- VEH-04: odometer readings entered directly; fuel and service entries also carry readings.
CREATE TABLE vehicle_reading (
    id TEXT NOT NULL PRIMARY KEY,
    vehicle_id TEXT NOT NULL REFERENCES vehicle(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    odometer INTEGER NOT NULL,
    notes TEXT
);

-- VEH-05: a task repeats every interval_months, every interval_km, or whichever comes first.
CREATE TABLE maintenance_task (
    id TEXT NOT NULL PRIMARY KEY,
    vehicle_id TEXT NOT NULL REFERENCES vehicle(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    template_key TEXT,
    interval_months INTEGER,
    interval_km INTEGER,
    -- Where the schedule starts until the task is first done.
    start_date TEXT,
    start_odometer INTEGER,
    remind_days INTEGER NOT NULL DEFAULT 14,
    remind_km INTEGER NOT NULL DEFAULT 500,
    active INTEGER NOT NULL DEFAULT 1,
    notes TEXT
);

-- VEH-06.
CREATE TABLE service_record (
    id TEXT NOT NULL PRIMARY KEY,
    vehicle_id TEXT NOT NULL REFERENCES vehicle(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    odometer INTEGER,
    provider TEXT,
    diy INTEGER NOT NULL DEFAULT 0,
    cost_minor INTEGER,
    txn_id TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE service_task (
    service_id TEXT NOT NULL REFERENCES service_record(id) ON DELETE CASCADE,
    task_id TEXT NOT NULL REFERENCES maintenance_task(id) ON DELETE CASCADE,
    PRIMARY KEY (service_id, task_id)
);

-- VEH-07: litres, or kWh for electric vehicles, as a decimal string.
CREATE TABLE fuel_entry (
    id TEXT NOT NULL PRIMARY KEY,
    vehicle_id TEXT NOT NULL REFERENCES vehicle(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    odometer INTEGER,
    quantity TEXT NOT NULL,
    cost_minor INTEGER,
    full_tank INTEGER NOT NULL DEFAULT 1,
    station TEXT,
    txn_id TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL
);

-- VEH-03.
CREATE TABLE vehicle_warranty (
    id TEXT NOT NULL PRIMARY KEY,
    vehicle_id TEXT NOT NULL REFERENCES vehicle(id) ON DELETE CASCADE,
    kind TEXT NOT NULL CHECK (kind IN ('MANUFACTURER', 'POWERTRAIN', 'EXTENDED', 'CORROSION', 'BATTERY', 'OTHER')),
    provider TEXT,
    start_date TEXT,
    end_date TEXT,
    end_km INTEGER,
    phone TEXT,
    notes TEXT
);

-- WAR-03 for vehicles (version 30): each claim made under a vehicle warranty, in the vehicle's currency.
CREATE TABLE vehicle_warranty_claim (
    id TEXT NOT NULL PRIMARY KEY,
    warranty_id TEXT NOT NULL REFERENCES vehicle_warranty(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    problem TEXT NOT NULL,
    outcome TEXT,
    covered_minor INTEGER,
    paid_minor INTEGER,
    notes TEXT
);

CREATE INDEX vehicle_warranty_claim_warranty ON vehicle_warranty_claim(warranty_id, date);

CREATE INDEX vehicle_reading_vehicle ON vehicle_reading(vehicle_id, date);
CREATE INDEX service_record_vehicle ON service_record(vehicle_id, date);
CREATE INDEX fuel_entry_vehicle ON fuel_entry(vehicle_id, date);

upsertVehicle:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, everything that belongs to it.
INSERT INTO vehicle(id, name, make, model, model_year, trim_level, colour, vin, plate, fuel_type, driver_member_id,
    purchase_date, purchase_price_minor, seller, purchase_odometer, currency, registration_renewal, insurer, policy_number,
    insurance_renewal, status, disposal_date, disposal_price_minor, notes, created_at, updated_at, disposal_txn_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    name = excluded.name,
    make = excluded.make,
    model = excluded.model,
    model_year = excluded.model_year,
    trim_level = excluded.trim_level,
    colour = excluded.colour,
    vin = excluded.vin,
    plate = excluded.plate,
    fuel_type = excluded.fuel_type,
    driver_member_id = excluded.driver_member_id,
    purchase_date = excluded.purchase_date,
    purchase_price_minor = excluded.purchase_price_minor,
    seller = excluded.seller,
    purchase_odometer = excluded.purchase_odometer,
    currency = excluded.currency,
    registration_renewal = excluded.registration_renewal,
    insurer = excluded.insurer,
    policy_number = excluded.policy_number,
    insurance_renewal = excluded.insurance_renewal,
    status = excluded.status,
    disposal_date = excluded.disposal_date,
    disposal_price_minor = excluded.disposal_price_minor,
    disposal_txn_id = excluded.disposal_txn_id,
    notes = excluded.notes,
    created_at = excluded.created_at,
    updated_at = excluded.updated_at;

deleteVehicle:
DELETE FROM vehicle WHERE id = ?;

vehicles:
SELECT * FROM vehicle ORDER BY status, name;

vehicleById:
SELECT * FROM vehicle WHERE id = ?;

insertReading:
INSERT INTO vehicle_reading(id, vehicle_id, date, odometer, notes) VALUES (?, ?, ?, ?, ?);

deleteReading:
DELETE FROM vehicle_reading WHERE id = ?;

readings:
SELECT * FROM vehicle_reading WHERE vehicle_id = ? ORDER BY date, odometer;

upsertTask:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, everything that belongs to it.
INSERT INTO maintenance_task(id, vehicle_id, name, template_key, interval_months, interval_km, start_date, start_odometer,
    remind_days, remind_km, active, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    vehicle_id = excluded.vehicle_id,
    name = excluded.name,
    template_key = excluded.template_key,
    interval_months = excluded.interval_months,
    interval_km = excluded.interval_km,
    start_date = excluded.start_date,
    start_odometer = excluded.start_odometer,
    remind_days = excluded.remind_days,
    remind_km = excluded.remind_km,
    active = excluded.active,
    notes = excluded.notes;

deleteTask:
DELETE FROM maintenance_task WHERE id = ?;

tasks:
SELECT * FROM maintenance_task WHERE vehicle_id = ? ORDER BY active DESC, name;

insertService:
INSERT INTO service_record(id, vehicle_id, date, odometer, provider, diy, cost_minor, txn_id, notes, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateService:
UPDATE service_record SET date = ?, odometer = ?, provider = ?, diy = ?, cost_minor = ?, txn_id = ?, notes = ? WHERE id = ?;

deleteService:
DELETE FROM service_record WHERE id = ?;

services:
SELECT * FROM service_record WHERE vehicle_id = ? ORDER BY date DESC, created_at DESC;

insertServiceTask:
INSERT OR IGNORE INTO service_task(service_id, task_id) VALUES (?, ?);

deleteServiceTasks:
DELETE FROM service_task WHERE service_id = ?;

serviceTasks:
SELECT st.service_id, st.task_id FROM service_task st JOIN service_record r ON r.id = st.service_id WHERE r.vehicle_id = ?;

insertFuel:
INSERT INTO fuel_entry(id, vehicle_id, date, odometer, quantity, cost_minor, full_tank, station, txn_id, notes, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFuel:
UPDATE fuel_entry SET date = ?, odometer = ?, quantity = ?, cost_minor = ?, full_tank = ?, station = ?, txn_id = ?, notes = ? WHERE id = ?;

deleteFuel:
DELETE FROM fuel_entry WHERE id = ?;

fuelEntries:
SELECT * FROM fuel_entry WHERE vehicle_id = ? ORDER BY date, odometer, created_at;

upsertWarranty:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, its claims.
INSERT INTO vehicle_warranty(id, vehicle_id, kind, provider, start_date, end_date, end_km, phone, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    vehicle_id = excluded.vehicle_id,
    kind = excluded.kind,
    provider = excluded.provider,
    start_date = excluded.start_date,
    end_date = excluded.end_date,
    end_km = excluded.end_km,
    phone = excluded.phone,
    notes = excluded.notes;

deleteWarranty:
DELETE FROM vehicle_warranty WHERE id = ?;

upsertWarrantyClaim:
INSERT INTO vehicle_warranty_claim(id, warranty_id, date, problem, outcome, covered_minor, paid_minor, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    date = excluded.date,
    problem = excluded.problem,
    outcome = excluded.outcome,
    covered_minor = excluded.covered_minor,
    paid_minor = excluded.paid_minor,
    notes = excluded.notes;

warrantyClaims:
SELECT * FROM vehicle_warranty_claim WHERE warranty_id = ? ORDER BY date DESC, id;

deleteWarrantyClaim:
DELETE FROM vehicle_warranty_claim WHERE id = ? AND warranty_id = ?;

warranties:
SELECT * FROM vehicle_warranty WHERE vehicle_id = ? ORDER BY end_date;
