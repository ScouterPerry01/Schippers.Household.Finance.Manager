-- Ledger database: the accounts and transactions of one account group.
-- Money is stored as INTEGER minor units plus a currency code, never as REAL (NFR-04).
-- Ids are UUIDv7 text, unique across every device (SYNC-02).

CREATE TABLE account (
    id TEXT NOT NULL PRIMARY KEY,
    institution_id TEXT,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    currency TEXT NOT NULL,
    -- SEC-04: the masked form is shown; the full number only after re-authentication.
    number_masked TEXT,
    number_full TEXT,
    opening_balance_minor INTEGER NOT NULL DEFAULT 0,
    opening_date TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'OPEN' CHECK (status IN ('OPEN', 'DORMANT', 'CLOSED')),
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- ACC-03: individual or joint ownership, by household member.
CREATE TABLE account_owner (
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    member_id TEXT NOT NULL,
    PRIMARY KEY (account_id, member_id)
);

CREATE TABLE txn (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id),
    date TEXT NOT NULL,
    payee_id TEXT,
    payee_text TEXT,
    -- Amount in the account's currency.
    amount_minor INTEGER NOT NULL,
    -- FX-03: original foreign amount and the rate actually charged.
    original_amount_minor INTEGER,
    original_currency TEXT,
    fx_rate TEXT,
    memo TEXT,
    member_id TEXT,
    cleared TEXT NOT NULL DEFAULT 'UNCLEARED' CHECK (cleared IN ('UNCLEARED', 'CLEARED', 'RECONCILED')),
    -- TX-03: both sides of a transfer share this id; the other side may be in another ledger.
    transfer_id TEXT,
    transfer_account_id TEXT,
    -- The institution's id for this transaction (OFX FITID, or a fingerprint for CSV lines),
    -- set when it is matched to an imported statement line (REC-10 duplicate protection).
    external_id TEXT,
    -- Who captured it and on which device (SYNC-07).
    created_by TEXT,
    source_device TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    -- VEH-09: the vehicle (or, later, other asset) the transaction is for.
    asset_id TEXT
);

CREATE INDEX txn_account_date ON txn(account_id, date, created_at, id);
CREATE INDEX txn_transfer ON txn(transfer_id) WHERE transfer_id IS NOT NULL;
-- Covers balances and running totals without reading (and decrypting) whole rows (NFR-02).
CREATE INDEX txn_account_amount ON txn(account_id, date, amount_minor, cleared);
-- Date ranges across all accounts (reports for a month or a year).
CREATE INDEX txn_date ON txn(date);
CREATE INDEX txn_asset ON txn(asset_id) WHERE asset_id IS NOT NULL;
CREATE UNIQUE INDEX txn_external ON txn(account_id, external_id) WHERE external_id IS NOT NULL;

-- TX-02: a transaction is split across categories; a simple transaction has one split.
CREATE TABLE txn_split (
    id TEXT NOT NULL PRIMARY KEY,
    txn_id TEXT NOT NULL REFERENCES txn(id) ON DELETE CASCADE,
    category_id TEXT,
    amount_minor INTEGER NOT NULL,
    memo TEXT,
    member_id TEXT,
    tax_flag TEXT
);

CREATE INDEX txn_split_txn ON txn_split(txn_id);
CREATE INDEX txn_split_category ON txn_split(category_id);

CREATE TABLE txn_tag (
    txn_id TEXT NOT NULL REFERENCES txn(id) ON DELETE CASCADE,
    tag_id TEXT NOT NULL,
    PRIMARY KEY (txn_id, tag_id)
);

-- Imported or manually entered statements, and their reconciliation (section 8).
CREATE TABLE statement (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    source_name TEXT,
    format TEXT,
    -- SHA-256 of the imported file: the same file is never imported twice (REC-10).
    file_sha256 TEXT,
    period_start TEXT,
    period_end TEXT NOT NULL,
    opening_balance_minor INTEGER,
    -- Unknown for a CSV export without a balance column, until the user enters it.
    closing_balance_minor INTEGER,
    status TEXT NOT NULL DEFAULT 'OPEN' CHECK (status IN ('OPEN', 'RECONCILED', 'UNDONE')),
    imported_at INTEGER NOT NULL,
    imported_by TEXT,
    reconciled_at INTEGER,
    reconciled_by TEXT,
    -- REC-06: cleared and outstanding items at completion, as JSON.
    report_json TEXT,
    undo_reason TEXT,
    document_id TEXT
);

CREATE INDEX statement_account ON statement(account_id, period_end);
CREATE UNIQUE INDEX statement_file ON statement(account_id, file_sha256) WHERE file_sha256 IS NOT NULL;

CREATE TABLE statement_line (
    id TEXT NOT NULL PRIMARY KEY,
    statement_id TEXT NOT NULL REFERENCES statement(id) ON DELETE CASCADE,
    line_no INTEGER NOT NULL,
    external_id TEXT NOT NULL,
    date TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,
    payee TEXT,
    memo TEXT,
    check_number TEXT,
    -- MATCHED: linked to an existing transaction; CREATED: a new transaction was added;
    -- PROPOSED: a likely match waiting for confirmation; DUPLICATE: already imported before;
    -- UNMATCHED: needs a decision; IGNORED: deliberately left out.
    status TEXT NOT NULL CHECK (status IN ('MATCHED', 'CREATED', 'PROPOSED', 'DUPLICATE', 'UNMATCHED', 'IGNORED')),
    txn_id TEXT
);

CREATE INDEX statement_line_statement ON statement_line(statement_id, line_no);

-- Bills, income and scheduled transfers (section 9). Stored in the ledger of the paying account.
CREATE TABLE bill (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL DEFAULT 'BILL' CHECK (kind IN ('BILL', 'INCOME', 'TRANSFER')),
    name TEXT NOT NULL,
    payee_name TEXT,
    -- BILL-01: the household's account number with the payee (e.g. Hydro-Québec contract).
    payee_account_number TEXT,
    -- Positive amount; the kind gives the direction.
    amount_minor INTEGER NOT NULL,
    amount_kind TEXT NOT NULL DEFAULT 'FIXED' CHECK (amount_kind IN ('FIXED', 'VARIABLE', 'ESTIMATED')),
    account_id TEXT NOT NULL REFERENCES account(id),
    transfer_account_id TEXT,
    payment_method TEXT NOT NULL DEFAULT 'ONLINE' CHECK (payment_method IN ('PAD', 'ONLINE', 'CARD', 'CHEQUE', 'CASH', 'OTHER')),
    category_id TEXT,
    recurrence TEXT NOT NULL,
    start_date TEXT NOT NULL,
    end_date TEXT,
    -- BILL-04: reminder lead times in days, e.g. "7,1".
    reminder_days TEXT NOT NULL DEFAULT '7,1',
    -- BILL-10: subscriptions, with renewal and cancellation reminder dates.
    is_subscription INTEGER NOT NULL DEFAULT 0,
    renewal_date TEXT,
    cancel_by TEXT,
    notes TEXT,
    active INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- One due date of a bill that has an actual amount, was paid or was skipped. Due dates without
-- a row are computed from the recurrence and are simply due.
CREATE TABLE bill_occurrence (
    id TEXT NOT NULL PRIMARY KEY,
    bill_id TEXT NOT NULL REFERENCES bill(id) ON DELETE CASCADE,
    due_date TEXT NOT NULL,
    amount_minor INTEGER,
    status TEXT NOT NULL DEFAULT 'DUE' CHECK (status IN ('DUE', 'PAID', 'SKIPPED')),
    txn_id TEXT,
    paid_date TEXT,
    document_id TEXT,
    UNIQUE (bill_id, due_date)
);

-- CC-01: credit card terms. Rates are decimal fractions stored as text (e.g. "0.1999").
CREATE TABLE credit_card (
    account_id TEXT NOT NULL PRIMARY KEY REFERENCES account(id) ON DELETE CASCADE,
    credit_limit_minor INTEGER,
    purchase_rate TEXT,
    cash_advance_rate TEXT,
    promo_rate TEXT,
    promo_ends TEXT,
    statement_day INTEGER CHECK (statement_day BETWEEN 1 AND 31),
    due_day INTEGER CHECK (due_day BETWEEN 1 AND 31),
    -- Minimum payment: the greater of a percentage of the balance and a fixed floor.
    min_payment_percent TEXT,
    min_payment_floor_minor INTEGER,
    annual_fee_minor INTEGER,
    -- Supplementary cards point to the main card's account (CC-05).
    primary_account_id TEXT
);

-- CC-02: one row per statement cycle.
CREATE TABLE card_statement (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    statement_date TEXT NOT NULL,
    balance_minor INTEGER NOT NULL,
    minimum_due_minor INTEGER NOT NULL,
    due_date TEXT NOT NULL,
    paid INTEGER NOT NULL DEFAULT 0,
    UNIQUE (account_id, statement_date)
);

-- Documents in the encrypted vault (section 4.4). The file itself is stored outside the database.
CREATE TABLE document (
    id TEXT NOT NULL PRIMARY KEY,
    vault_file TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    sha256 TEXT NOT NULL,
    page_count INTEGER NOT NULL DEFAULT 1,
    recognized_text TEXT,
    captured_at INTEGER NOT NULL,
    captured_by TEXT,
    source_device TEXT,
    -- Version 4 (section 4.4, OCR-02, CAP-03): review and search fields.
    file_name TEXT,
    title TEXT,
    -- INBOX until reviewed (SYNC-05), then FILED; DISMISSED documents stay in the vault unfiled.
    status TEXT NOT NULL DEFAULT 'FILED',
    kind TEXT,
    doc_date TEXT,
    merchant TEXT,
    amount_minor INTEGER,
    currency TEXT,
    -- The extracted fields with their confidence, as JSON (OCR-05).
    extraction TEXT,
    ocr_engine TEXT,
    size_bytes INTEGER,
    -- Retention (section 4.4): kept indefinitely when set, otherwise flagged after the CRA period.
    keep_forever INTEGER NOT NULL DEFAULT 0,
    notes TEXT,
    updated_at INTEGER
);

CREATE INDEX document_sha ON document(sha256);
CREATE INDEX document_status ON document(status, captured_at);
CREATE INDEX document_date ON document(doc_date);
CREATE INDEX document_link_entity ON document_link(entity, entity_id);

CREATE TABLE document_link (
    document_id TEXT NOT NULL REFERENCES document(id) ON DELETE CASCADE,
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    PRIMARY KEY (document_id, entity, entity_id)
);

-- TX-08: full change history per record, kept inside the same encrypted ledger.
CREATE TABLE change_log (
    id TEXT NOT NULL PRIMARY KEY,
    at INTEGER NOT NULL,
    user_id TEXT,
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    action TEXT NOT NULL CHECK (action IN ('CREATE', 'UPDATE', 'DELETE')),
    before_json TEXT,
    after_json TEXT
);

CREATE INDEX change_log_entity ON change_log(entity, entity_id);

-- Accounts --------------------------------------------------------------------------------

insertAccount:
INSERT INTO account(id, institution_id, name, type, currency, number_masked, number_full,
    opening_balance_minor, opening_date, status, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateAccount:
UPDATE account SET institution_id = ?, name = ?, number_masked = ?, number_full = ?,
    opening_balance_minor = ?, opening_date = ?, status = ?, notes = ?, updated_at = ?
WHERE id = ?;

accounts:
SELECT * FROM account ORDER BY name;

accountById:
SELECT * FROM account WHERE id = ?;

insertAccountOwner:
INSERT OR IGNORE INTO account_owner(account_id, member_id) VALUES (?, ?);

deleteAccountOwners:
DELETE FROM account_owner WHERE account_id = ?;

accountOwners:
SELECT * FROM account_owner;

accountBalance:
SELECT a.opening_balance_minor + coalesce((SELECT sum(t.amount_minor) FROM txn t WHERE t.account_id = a.id), 0)
FROM account a WHERE a.id = ?;

-- Current and cleared balance of every account in this ledger.
balances:
SELECT a.id,
    CAST(a.opening_balance_minor + coalesce(sum(t.amount_minor), 0) AS INTEGER) AS balance,
    CAST(a.opening_balance_minor + coalesce(sum(CASE WHEN t.cleared != 'UNCLEARED' THEN t.amount_minor ELSE 0 END), 0) AS INTEGER) AS cleared_balance
FROM account a LEFT JOIN txn t ON t.account_id = a.id
GROUP BY a.id;

-- Credit cards ------------------------------------------------------------------------------

upsertCreditCard:
INSERT OR REPLACE INTO credit_card(account_id, credit_limit_minor, purchase_rate, cash_advance_rate, promo_rate,
    promo_ends, statement_day, due_day, min_payment_percent, min_payment_floor_minor, annual_fee_minor, primary_account_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

creditCard:
SELECT * FROM credit_card WHERE account_id = ?;

upsertCardStatement:
INSERT OR REPLACE INTO card_statement(id, account_id, statement_date, balance_minor, minimum_due_minor, due_date, paid)
VALUES (?, ?, ?, ?, ?, ?, ?);

cardStatements:
SELECT * FROM card_statement WHERE account_id = ? ORDER BY statement_date DESC;

-- Transactions ------------------------------------------------------------------------------

insertTxn:
INSERT INTO txn(id, account_id, date, payee_id, payee_text, amount_minor, original_amount_minor,
    original_currency, fx_rate, memo, member_id, cleared, transfer_id, transfer_account_id,
    created_by, source_device, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateTxn:
UPDATE txn SET date = ?, payee_id = ?, payee_text = ?, amount_minor = ?, original_amount_minor = ?,
    original_currency = ?, fx_rate = ?, memo = ?, member_id = ?, cleared = ?, transfer_id = ?,
    transfer_account_id = ?, updated_at = ?
WHERE id = ?;

setCleared:
UPDATE txn SET cleared = ?, updated_at = ? WHERE id = ?;

deleteTxn:
DELETE FROM txn WHERE id = ?;

txnById:
SELECT * FROM txn WHERE id = ?;

txnsByTransfer:
SELECT * FROM txn WHERE transfer_id = ?;

-- Account register with running balance, oldest first.
register:
SELECT t.*,
    CAST((SELECT a.opening_balance_minor FROM account a WHERE a.id = t.account_id)
        + sum(t.amount_minor) OVER (ORDER BY t.date, t.created_at, t.id ROWS UNBOUNDED PRECEDING) AS INTEGER) AS running_balance
FROM txn t
WHERE t.account_id = ?
ORDER BY t.date, t.created_at, t.id;

-- The most recent transactions of an account, newest first (read from the index; NFR-02).
latestForAccount:
SELECT * FROM txn
WHERE account_id = :account
ORDER BY date DESC, created_at DESC, id DESC
LIMIT :limit;

clearedForAccount:
SELECT * FROM txn WHERE account_id = ? AND cleared = 'CLEARED' ORDER BY date, created_at;

txnCountForAccount:
SELECT count(*) FROM txn WHERE account_id = ?;

splitsForAccountFrom:
SELECT s.* FROM txn_split s JOIN txn t ON t.id = s.txn_id WHERE t.account_id = ? AND t.date >= ?;

tagsForAccountFrom:
SELECT tt.* FROM txn_tag tt JOIN txn t ON t.id = tt.txn_id WHERE t.account_id = ? AND t.date >= ?;

txnCount:
SELECT count(*) FROM txn;

insertSplit:
INSERT INTO txn_split(id, txn_id, category_id, amount_minor, memo, member_id, tax_flag)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteSplits:
DELETE FROM txn_split WHERE txn_id = ?;

splitsForTxn:
SELECT * FROM txn_split WHERE txn_id = ?;


-- Most recent use of each payee, for auto-complete (MAN-02).
lastUseOfPayee:
SELECT t.* FROM txn t WHERE t.payee_id = ? ORDER BY t.date DESC, t.created_at DESC LIMIT 1;

insertTxnTag:
INSERT OR IGNORE INTO txn_tag(txn_id, tag_id) VALUES (?, ?);

deleteTxnTags:
DELETE FROM txn_tag WHERE txn_id = ?;

tagsForTxn:
SELECT tag_id FROM txn_tag WHERE txn_id = ?;


setExternalId:
UPDATE txn SET external_id = ?, updated_at = ? WHERE id = ?;

txnByExternalId:
SELECT * FROM txn WHERE account_id = ? AND external_id = ?;

-- Candidates for matching a statement line: same account and amount, not yet matched.
matchCandidates:
SELECT * FROM txn
WHERE account_id = ? AND amount_minor = ? AND external_id IS NULL AND cleared != 'RECONCILED'
  AND date BETWEEN ? AND ?;

unreconciledThrough:
SELECT * FROM txn WHERE account_id = ? AND cleared != 'RECONCILED' AND date <= ? ORDER BY date, created_at;

clearedBalance:
SELECT CAST(a.opening_balance_minor + coalesce(sum(t.amount_minor), 0) AS INTEGER)
FROM account a LEFT JOIN txn t ON t.account_id = a.id AND t.cleared != 'UNCLEARED'
WHERE a.id = ?
GROUP BY a.id;

setClearedFor:
UPDATE txn SET cleared = ?, updated_at = ? WHERE account_id = ? AND cleared = ? AND date <= ?;

-- Global search (OTH-03): text in the payee or memo, a known payee, or an amount either way.
searchTxns:
SELECT * FROM txn
WHERE payee_text LIKE :pattern ESCAPE '!' OR memo LIKE :pattern ESCAPE '!' OR payee_id IN :payeeIds
   OR amount_minor = :amount OR amount_minor = :negativeAmount
ORDER BY date DESC, created_at DESC
LIMIT :limit;

-- Reports (section 12) ---------------------------------------------------------------------
-- Transfers between own accounts are never income or spending (TX-03), so they are left out.


-- Monthly totals per account and category: enough for accounts in the base currency.
categoryMonthly:
SELECT t.account_id, s.category_id, substr(t.date, 1, 7) AS month, CAST(sum(s.amount_minor) AS INTEGER) AS total
FROM txn_split s JOIN txn t ON t.id = s.txn_id
WHERE t.date >= :from AND t.date <= :to AND t.transfer_id IS NULL
  AND (:member IS NULL OR coalesce(s.member_id, t.member_id) = :member)
  AND (:tag IS NULL OR EXISTS (SELECT 1 FROM txn_tag g WHERE g.txn_id = t.id AND g.tag_id = :tag))
GROUP BY t.account_id, s.category_id, month;

-- The same for long ranges: "+t.date" stops SQLite from using the date index, because reading
-- most of the table row by row through an index is far slower than reading it straight (NFR-02).
categoryMonthlyWide:
SELECT t.account_id, s.category_id, substr(t.date, 1, 7) AS month, CAST(sum(s.amount_minor) AS INTEGER) AS total
FROM txn_split s JOIN txn t ON t.id = s.txn_id
WHERE +t.date >= :from AND +t.date <= :to AND t.transfer_id IS NULL
  AND (:member IS NULL OR coalesce(s.member_id, t.member_id) = :member)
  AND (:tag IS NULL OR EXISTS (SELECT 1 FROM txn_tag g WHERE g.txn_id = t.id AND g.tag_id = :tag))
GROUP BY t.account_id, s.category_id, month;

-- Daily totals for the given accounts only: foreign-currency accounts, converted at each day's rate.
categoryDailyFor:
SELECT t.account_id, s.category_id, t.date, CAST(sum(s.amount_minor) AS INTEGER) AS total
FROM txn_split s JOIN txn t ON t.id = s.txn_id
WHERE t.date >= :from AND t.date <= :to AND t.transfer_id IS NULL AND t.account_id IN :accounts
  AND (:member IS NULL OR coalesce(s.member_id, t.member_id) = :member)
  AND (:tag IS NULL OR EXISTS (SELECT 1 FROM txn_tag g WHERE g.txn_id = t.id AND g.tag_id = :tag))
GROUP BY t.account_id, s.category_id, t.date;

-- Balance movement per account up to and including a date (from the covering index).
balancesThrough:
SELECT account_id, CAST(sum(amount_minor) AS INTEGER) AS total
FROM txn WHERE date <= :through
GROUP BY account_id;

-- Net change per account and day after one date up to another, for running balances.
dailyNetChange:
SELECT account_id, date, CAST(sum(amount_minor) AS INTEGER) AS total
FROM txn WHERE date > :after AND date <= :to
GROUP BY account_id, date
ORDER BY date;

payeeDailyWide:
SELECT t.account_id, t.payee_id, coalesce(t.payee_text, '') AS payee_text, t.date, CAST(sum(t.amount_minor) AS INTEGER) AS total
FROM txn t
WHERE +t.date >= :from AND +t.date <= :to AND t.transfer_id IS NULL
  AND (:member IS NULL OR t.member_id = :member)
  AND (:tag IS NULL OR EXISTS (SELECT 1 FROM txn_tag g WHERE g.txn_id = t.id AND g.tag_id = :tag))
GROUP BY t.account_id, t.payee_id, payee_text, t.date;

payeeDaily:
SELECT t.account_id, t.payee_id, coalesce(t.payee_text, '') AS payee_text, t.date, CAST(sum(t.amount_minor) AS INTEGER) AS total
FROM txn t
WHERE t.date >= :from AND t.date <= :to AND t.transfer_id IS NULL
  AND (:member IS NULL OR t.member_id = :member)
  AND (:tag IS NULL OR EXISTS (SELECT 1 FROM txn_tag g WHERE g.txn_id = t.id AND g.tag_id = :tag))
GROUP BY t.account_id, t.payee_id, payee_text, t.date;

reportSplits:
SELECT t.id AS txn_id, t.account_id, t.date, t.payee_id, t.payee_text, t.memo, s.category_id, s.amount_minor
FROM txn_split s JOIN txn t ON t.id = s.txn_id
WHERE t.date >= :from AND t.date <= :to AND t.transfer_id IS NULL
  AND (:member IS NULL OR coalesce(s.member_id, t.member_id) = :member)
  AND (:tag IS NULL OR EXISTS (SELECT 1 FROM txn_tag g WHERE g.txn_id = t.id AND g.tag_id = :tag))
ORDER BY t.date, t.created_at;


uncategorizedCount:
SELECT count(*) FROM txn t WHERE t.transfer_id IS NULL AND EXISTS (SELECT 1 FROM txn_split s WHERE s.txn_id = t.id AND s.category_id IS NULL);

-- Bills ---------------------------------------------------------------------------------

insertBill:
INSERT INTO bill(id, kind, name, payee_name, payee_account_number, amount_minor, amount_kind, account_id, transfer_account_id,
    payment_method, category_id, recurrence, start_date, end_date, reminder_days, is_subscription, renewal_date, cancel_by,
    notes, active, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateBill:
UPDATE bill SET kind = ?, name = ?, payee_name = ?, payee_account_number = ?, amount_minor = ?, amount_kind = ?,
    account_id = ?, transfer_account_id = ?, payment_method = ?, category_id = ?, recurrence = ?, start_date = ?, end_date = ?,
    reminder_days = ?, is_subscription = ?, renewal_date = ?, cancel_by = ?, notes = ?, active = ?, updated_at = ?
WHERE id = ?;

deleteBill:
DELETE FROM bill WHERE id = ?;

bills:
SELECT * FROM bill ORDER BY name;

billById:
SELECT * FROM bill WHERE id = ?;

upsertOccurrence:
INSERT INTO bill_occurrence(id, bill_id, due_date, amount_minor, status, txn_id, paid_date, document_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(bill_id, due_date) DO UPDATE SET amount_minor = excluded.amount_minor, status = excluded.status,
    txn_id = excluded.txn_id, paid_date = excluded.paid_date, document_id = excluded.document_id;

occurrencesForBill:
SELECT * FROM bill_occurrence WHERE bill_id = ? ORDER BY due_date;

deleteOccurrence:
DELETE FROM bill_occurrence WHERE bill_id = ? AND due_date = ?;

-- Statements --------------------------------------------------------------------------------

insertStatement:
INSERT INTO statement(id, account_id, source_name, format, file_sha256, period_start, period_end,
    opening_balance_minor, closing_balance_minor, status, imported_at, imported_by)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'OPEN', ?, ?);

updateStatementBalances:
UPDATE statement SET period_start = ?, period_end = ?, opening_balance_minor = ?, closing_balance_minor = ? WHERE id = ?;

completeStatement:
UPDATE statement SET status = 'RECONCILED', reconciled_at = ?, reconciled_by = ?, report_json = ? WHERE id = ?;

undoStatement:
UPDATE statement SET status = 'UNDONE', undo_reason = ? WHERE id = ?;

statementById:
SELECT * FROM statement WHERE id = ?;

statementsForAccount:
SELECT * FROM statement WHERE account_id = ? ORDER BY period_end DESC, imported_at DESC;

statementByFile:
SELECT * FROM statement WHERE account_id = ? AND file_sha256 = ?;

lastReconciled:
SELECT account_id, max(period_end) AS period_end FROM statement WHERE status = 'RECONCILED' GROUP BY account_id;

insertStatementLine:
INSERT INTO statement_line(id, statement_id, line_no, external_id, date, amount_minor, payee, memo, check_number, status, txn_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

statementLines:
SELECT * FROM statement_line WHERE statement_id = ? ORDER BY line_no;

statementLineById:
SELECT * FROM statement_line WHERE id = ?;

setLineStatus:
UPDATE statement_line SET status = ?, txn_id = ? WHERE id = ?;

-- Change history (TX-08) --------------------------------------------------------------------

insertChange:
INSERT INTO change_log(id, at, user_id, entity, entity_id, action, before_json, after_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

changesFor:
SELECT * FROM change_log WHERE entity = ? AND entity_id = ? ORDER BY at, id;

setTxnAsset:
UPDATE txn SET asset_id = ? WHERE id = ?;

-- VEH-10: the lines of transactions linked to an asset.
assetLines:
SELECT t.id, t.date, t.account_id, s.category_id, s.amount_minor
FROM txn_split s JOIN txn t ON t.id = s.txn_id
WHERE t.asset_id = :asset AND t.transfer_id IS NULL AND t.date >= :from AND t.date <= :to;

-- PET-05: the lines recorded for one person or pet.
memberLines:
SELECT t.id, t.date, t.account_id, s.category_id, s.amount_minor
FROM txn_split s JOIN txn t ON t.id = s.txn_id
WHERE coalesce(s.member_id, t.member_id) = :member AND t.transfer_id IS NULL AND t.date >= :from AND t.date <= :to;

-- Document vault (section 4.4) -----------------------------------------------------------------

insertDocument:
INSERT INTO document(id, vault_file, mime_type, sha256, page_count, recognized_text, captured_at, captured_by, source_device,
    file_name, title, status, kind, doc_date, merchant, amount_minor, currency, extraction, ocr_engine, size_bytes, keep_forever, notes, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDocumentText:
UPDATE document SET page_count = ?, recognized_text = ?, kind = ?, doc_date = ?, merchant = ?, amount_minor = ?, currency = ?, extraction = ?,
    ocr_engine = ?, updated_at = ?
WHERE id = ?;

updateDocumentDetails:
UPDATE document SET title = ?, status = ?, kind = ?, doc_date = ?, merchant = ?, amount_minor = ?, currency = ?, keep_forever = ?, notes = ?, updated_at = ?
WHERE id = ?;

setDocumentStatus:
UPDATE document SET status = ?, updated_at = ? WHERE id = ?;

deleteDocument:
DELETE FROM document WHERE id = ?;

documentById:
SELECT * FROM document WHERE id = ?;

documentsBySha:
SELECT * FROM document WHERE sha256 = ?;

documentsByStatus:
SELECT * FROM document WHERE status = ? ORDER BY captured_at DESC;

-- Section 4.4: by recognised text, title, merchant or notes, and by date and amount.
searchDocuments:
SELECT * FROM document
WHERE (:text IS NULL OR recognized_text LIKE :text ESCAPE '!' OR title LIKE :text ESCAPE '!' OR merchant LIKE :text ESCAPE '!'
        OR notes LIKE :text ESCAPE '!' OR file_name LIKE :text ESCAPE '!')
  AND (:fromDate IS NULL OR coalesce(doc_date, date(captured_at / 1000, 'unixepoch')) >= :fromDate)
  AND (:toDate IS NULL OR coalesce(doc_date, date(captured_at / 1000, 'unixepoch')) <= :toDate)
  AND (:minAmount IS NULL OR abs(amount_minor) >= :minAmount)
  AND (:maxAmount IS NULL OR abs(amount_minor) <= :maxAmount)
ORDER BY coalesce(doc_date, date(captured_at / 1000, 'unixepoch')) DESC, captured_at DESC
LIMIT :limit;

-- OCR-10: earlier documents with the same merchant, date and amount.
similarDocuments:
SELECT * FROM document WHERE id != :id AND doc_date = :date AND amount_minor = :amount;

linkDocument:
INSERT OR IGNORE INTO document_link(document_id, entity, entity_id) VALUES (?, ?, ?);

unlinkDocument:
DELETE FROM document_link WHERE document_id = ? AND entity = ? AND entity_id = ?;

linksForDocument:
SELECT * FROM document_link WHERE document_id = ?;

documentsFor:
SELECT d.* FROM document d JOIN document_link l ON l.document_id = d.id WHERE l.entity = ? AND l.entity_id = ? ORDER BY d.captured_at DESC;

documentCounts:
SELECT status, count(*) AS total FROM document GROUP BY status;

-- Matching a captured receipt or bill to a transaction already entered or imported.
txnsNear:
SELECT * FROM txn WHERE date >= :from AND date <= :to AND (amount_minor = :amount OR amount_minor = -:amount) AND transfer_id IS NULL
ORDER BY date;
