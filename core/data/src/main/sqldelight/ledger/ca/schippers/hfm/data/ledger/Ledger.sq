-- Ledger database: the accounts and transactions of one account group.
-- Money is stored as INTEGER minor units plus a currency code, never as REAL (NFR-04).
-- Ids are UUIDv7 text, unique across every device (SYNC-02).

CREATE TABLE account (
    id TEXT NOT NULL PRIMARY KEY,
    institution_id TEXT,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    currency TEXT NOT NULL,
    -- SEC-04: the masked form is shown; the full number only after re-authentication.
    number_masked TEXT,
    number_full TEXT,
    opening_balance_minor INTEGER NOT NULL DEFAULT 0,
    opening_date TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'OPEN' CHECK (status IN ('OPEN', 'DORMANT', 'CLOSED')),
    notes TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- ACC-03: individual or joint ownership, by household member.
CREATE TABLE account_owner (
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    member_id TEXT NOT NULL,
    PRIMARY KEY (account_id, member_id)
);

CREATE TABLE txn (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id),
    date TEXT NOT NULL,
    payee_id TEXT,
    payee_text TEXT,
    -- Amount in the account's currency.
    amount_minor INTEGER NOT NULL,
    -- FX-03: original foreign amount and the rate actually charged.
    original_amount_minor INTEGER,
    original_currency TEXT,
    fx_rate TEXT,
    memo TEXT,
    member_id TEXT,
    cleared TEXT NOT NULL DEFAULT 'UNCLEARED' CHECK (cleared IN ('UNCLEARED', 'CLEARED', 'RECONCILED')),
    -- TX-03: both sides of a transfer share this id; the other side may be in another ledger.
    transfer_id TEXT,
    transfer_account_id TEXT,
    -- Who captured it and on which device (SYNC-07).
    created_by TEXT,
    source_device TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX txn_account_date ON txn(account_id, date, created_at, id);
CREATE INDEX txn_transfer ON txn(transfer_id) WHERE transfer_id IS NOT NULL;

-- TX-02: a transaction is split across categories; a simple transaction has one split.
CREATE TABLE txn_split (
    id TEXT NOT NULL PRIMARY KEY,
    txn_id TEXT NOT NULL REFERENCES txn(id) ON DELETE CASCADE,
    category_id TEXT,
    amount_minor INTEGER NOT NULL,
    memo TEXT,
    member_id TEXT,
    tax_flag TEXT
);

CREATE INDEX txn_split_txn ON txn_split(txn_id);
CREATE INDEX txn_split_category ON txn_split(category_id);

CREATE TABLE txn_tag (
    txn_id TEXT NOT NULL REFERENCES txn(id) ON DELETE CASCADE,
    tag_id TEXT NOT NULL,
    PRIMARY KEY (txn_id, tag_id)
);

-- CC-01: credit card terms. Rates are decimal fractions stored as text (e.g. "0.1999").
CREATE TABLE credit_card (
    account_id TEXT NOT NULL PRIMARY KEY REFERENCES account(id) ON DELETE CASCADE,
    credit_limit_minor INTEGER,
    purchase_rate TEXT,
    cash_advance_rate TEXT,
    promo_rate TEXT,
    promo_ends TEXT,
    statement_day INTEGER CHECK (statement_day BETWEEN 1 AND 31),
    due_day INTEGER CHECK (due_day BETWEEN 1 AND 31),
    -- Minimum payment: the greater of a percentage of the balance and a fixed floor.
    min_payment_percent TEXT,
    min_payment_floor_minor INTEGER,
    annual_fee_minor INTEGER,
    -- Supplementary cards point to the main card's account (CC-05).
    primary_account_id TEXT
);

-- CC-02: one row per statement cycle.
CREATE TABLE card_statement (
    id TEXT NOT NULL PRIMARY KEY,
    account_id TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
    statement_date TEXT NOT NULL,
    balance_minor INTEGER NOT NULL,
    minimum_due_minor INTEGER NOT NULL,
    due_date TEXT NOT NULL,
    paid INTEGER NOT NULL DEFAULT 0,
    UNIQUE (account_id, statement_date)
);

-- Documents in the encrypted vault (section 4.4). The file itself is stored outside the database.
CREATE TABLE document (
    id TEXT NOT NULL PRIMARY KEY,
    vault_file TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    sha256 TEXT NOT NULL,
    page_count INTEGER NOT NULL DEFAULT 1,
    recognized_text TEXT,
    captured_at INTEGER NOT NULL,
    captured_by TEXT,
    source_device TEXT
);

CREATE INDEX document_sha ON document(sha256);

CREATE TABLE document_link (
    document_id TEXT NOT NULL REFERENCES document(id) ON DELETE CASCADE,
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    PRIMARY KEY (document_id, entity, entity_id)
);

-- TX-08: full change history per record, kept inside the same encrypted ledger.
CREATE TABLE change_log (
    id TEXT NOT NULL PRIMARY KEY,
    at INTEGER NOT NULL,
    user_id TEXT,
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    action TEXT NOT NULL CHECK (action IN ('CREATE', 'UPDATE', 'DELETE')),
    before_json TEXT,
    after_json TEXT
);

CREATE INDEX change_log_entity ON change_log(entity, entity_id);

-- Accounts --------------------------------------------------------------------------------

insertAccount:
INSERT INTO account(id, institution_id, name, type, currency, number_masked, number_full,
    opening_balance_minor, opening_date, status, notes, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateAccount:
UPDATE account SET institution_id = ?, name = ?, number_masked = ?, number_full = ?,
    opening_balance_minor = ?, opening_date = ?, status = ?, notes = ?, updated_at = ?
WHERE id = ?;

accounts:
SELECT * FROM account ORDER BY name;

accountById:
SELECT * FROM account WHERE id = ?;

insertAccountOwner:
INSERT OR IGNORE INTO account_owner(account_id, member_id) VALUES (?, ?);

deleteAccountOwners:
DELETE FROM account_owner WHERE account_id = ?;

accountOwners:
SELECT * FROM account_owner;

accountBalance:
SELECT a.opening_balance_minor + coalesce((SELECT sum(t.amount_minor) FROM txn t WHERE t.account_id = a.id), 0)
FROM account a WHERE a.id = ?;

-- Current and cleared balance of every account in this ledger.
balances:
SELECT a.id,
    CAST(a.opening_balance_minor + coalesce(sum(t.amount_minor), 0) AS INTEGER) AS balance,
    CAST(a.opening_balance_minor + coalesce(sum(CASE WHEN t.cleared != 'UNCLEARED' THEN t.amount_minor ELSE 0 END), 0) AS INTEGER) AS cleared_balance
FROM account a LEFT JOIN txn t ON t.account_id = a.id
GROUP BY a.id;

-- Credit cards ------------------------------------------------------------------------------

upsertCreditCard:
INSERT OR REPLACE INTO credit_card(account_id, credit_limit_minor, purchase_rate, cash_advance_rate, promo_rate,
    promo_ends, statement_day, due_day, min_payment_percent, min_payment_floor_minor, annual_fee_minor, primary_account_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

creditCard:
SELECT * FROM credit_card WHERE account_id = ?;

upsertCardStatement:
INSERT OR REPLACE INTO card_statement(id, account_id, statement_date, balance_minor, minimum_due_minor, due_date, paid)
VALUES (?, ?, ?, ?, ?, ?, ?);

cardStatements:
SELECT * FROM card_statement WHERE account_id = ? ORDER BY statement_date DESC;

-- Transactions ------------------------------------------------------------------------------

insertTxn:
INSERT INTO txn(id, account_id, date, payee_id, payee_text, amount_minor, original_amount_minor,
    original_currency, fx_rate, memo, member_id, cleared, transfer_id, transfer_account_id,
    created_by, source_device, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateTxn:
UPDATE txn SET date = ?, payee_id = ?, payee_text = ?, amount_minor = ?, original_amount_minor = ?,
    original_currency = ?, fx_rate = ?, memo = ?, member_id = ?, cleared = ?, transfer_id = ?,
    transfer_account_id = ?, updated_at = ?
WHERE id = ?;

setCleared:
UPDATE txn SET cleared = ?, updated_at = ? WHERE id = ?;

deleteTxn:
DELETE FROM txn WHERE id = ?;

txnById:
SELECT * FROM txn WHERE id = ?;

txnsByTransfer:
SELECT * FROM txn WHERE transfer_id = ?;

-- Account register with running balance, oldest first.
register:
SELECT t.*,
    CAST((SELECT a.opening_balance_minor FROM account a WHERE a.id = t.account_id)
        + sum(t.amount_minor) OVER (ORDER BY t.date, t.created_at, t.id ROWS UNBOUNDED PRECEDING) AS INTEGER) AS running_balance
FROM txn t
WHERE t.account_id = ?
ORDER BY t.date, t.created_at, t.id;

txnCount:
SELECT count(*) FROM txn;

insertSplit:
INSERT INTO txn_split(id, txn_id, category_id, amount_minor, memo, member_id, tax_flag)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteSplits:
DELETE FROM txn_split WHERE txn_id = ?;

splitsForTxn:
SELECT * FROM txn_split WHERE txn_id = ?;

splitsForAccount:
SELECT s.* FROM txn_split s JOIN txn t ON t.id = s.txn_id WHERE t.account_id = ?;

-- Most recent use of each payee, for auto-complete (MAN-02).
lastUseOfPayee:
SELECT t.* FROM txn t WHERE t.payee_id = ? ORDER BY t.date DESC, t.created_at DESC LIMIT 1;

insertTxnTag:
INSERT OR IGNORE INTO txn_tag(txn_id, tag_id) VALUES (?, ?);

deleteTxnTags:
DELETE FROM txn_tag WHERE txn_id = ?;

tagsForTxn:
SELECT tag_id FROM txn_tag WHERE txn_id = ?;

tagsForAccount:
SELECT tt.* FROM txn_tag tt JOIN txn t ON t.id = tt.txn_id WHERE t.account_id = ?;

-- Change history (TX-08) --------------------------------------------------------------------

insertChange:
INSERT INTO change_log(id, at, user_id, entity, entity_id, action, before_json, after_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

changesFor:
SELECT * FROM change_log WHERE entity = ? AND entity_id = ? ORDER BY at, id;
