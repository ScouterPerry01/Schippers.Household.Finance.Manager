-- Maintenance for assets other than vehicles (MNT-01 to MNT-06): tasks, meter readings and
-- the service log. Vehicles keep theirs in Vehicles.sq.

-- MNT-01: a task for an asset repeats every interval_months, every interval_usage on the asset's
-- meter (hours or km), or whichever comes first. A seasonal task repeats every 12 months from its
-- first date. start_* is where the schedule starts until the task is first done.
CREATE TABLE asset_task (
    id TEXT NOT NULL PRIMARY KEY,
    asset_id TEXT NOT NULL REFERENCES asset(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    template_key TEXT,
    interval_months INTEGER,
    interval_usage INTEGER,
    start_date TEXT,
    start_usage INTEGER,
    remind_days INTEGER NOT NULL DEFAULT 14,
    remind_usage INTEGER NOT NULL DEFAULT 10,
    active INTEGER NOT NULL DEFAULT 1,
    notes TEXT,
    -- SEA-01 (version 31): every so many weeks, and only from season_from to season_to (month-day).
    interval_weeks INTEGER,
    season_from TEXT,
    season_to TEXT
);

-- MNT-03: meter readings (engine hours, or km for an RV), typed or from the phone.
CREATE TABLE asset_reading (
    id TEXT NOT NULL PRIMARY KEY,
    asset_id TEXT NOT NULL REFERENCES asset(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    usage INTEGER NOT NULL,
    notes TEXT
);

-- MNT-04: service log, in the asset's currency.
CREATE TABLE asset_service (
    id TEXT NOT NULL PRIMARY KEY,
    asset_id TEXT NOT NULL REFERENCES asset(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    usage INTEGER,
    provider TEXT,
    diy INTEGER NOT NULL DEFAULT 0,
    parts TEXT,
    cost_minor INTEGER,
    txn_id TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE asset_service_task (
    service_id TEXT NOT NULL REFERENCES asset_service(id) ON DELETE CASCADE,
    task_id TEXT NOT NULL REFERENCES asset_task(id) ON DELETE CASCADE,
    PRIMARY KEY (service_id, task_id)
);

CREATE INDEX asset_task_asset ON asset_task(asset_id);
CREATE INDEX asset_reading_asset ON asset_reading(asset_id, date);
CREATE INDEX asset_service_asset ON asset_service(asset_id, date);

upsertTask:
-- Updates in place: INSERT OR REPLACE would delete the row first and, through ON DELETE
-- CASCADE, everything that belongs to it.
INSERT INTO asset_task(id, asset_id, name, template_key, interval_months, interval_usage, start_date, start_usage,
    remind_days, remind_usage, active, notes, interval_weeks, season_from, season_to)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    asset_id = excluded.asset_id,
    name = excluded.name,
    template_key = excluded.template_key,
    interval_months = excluded.interval_months,
    interval_usage = excluded.interval_usage,
    start_date = excluded.start_date,
    start_usage = excluded.start_usage,
    remind_days = excluded.remind_days,
    remind_usage = excluded.remind_usage,
    active = excluded.active,
    notes = excluded.notes,
    interval_weeks = excluded.interval_weeks,
    season_from = excluded.season_from,
    season_to = excluded.season_to;

deleteTask:
DELETE FROM asset_task WHERE id = ?;

tasks:
SELECT * FROM asset_task WHERE asset_id = ? ORDER BY active DESC, name;

allTasks:
SELECT * FROM asset_task WHERE active = 1;

insertReading:
INSERT INTO asset_reading(id, asset_id, date, usage, notes) VALUES (?, ?, ?, ?, ?);

deleteReading:
DELETE FROM asset_reading WHERE id = ?;

readings:
SELECT * FROM asset_reading WHERE asset_id = ? ORDER BY date, usage;

insertService:
INSERT INTO asset_service(id, asset_id, date, usage, provider, diy, parts, cost_minor, txn_id, notes, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateService:
UPDATE asset_service SET date = ?, usage = ?, provider = ?, diy = ?, parts = ?, cost_minor = ?, txn_id = ?, notes = ? WHERE id = ?;

deleteService:
DELETE FROM asset_service WHERE id = ?;

services:
SELECT * FROM asset_service WHERE asset_id = ? ORDER BY date DESC, created_at DESC;

insertServiceTask:
INSERT OR IGNORE INTO asset_service_task(service_id, task_id) VALUES (?, ?);

deleteServiceTasks:
DELETE FROM asset_service_task WHERE service_id = ?;

serviceTasks:
SELECT st.service_id, st.task_id FROM asset_service_task st JOIN asset_service r ON r.id = st.service_id WHERE r.asset_id = ?;
