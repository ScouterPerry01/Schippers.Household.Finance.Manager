-- Rates and rules (core version 8): a value the household gives a rate, limit or threshold, in
-- effect from a date, for one province or territory or for all (province NULL). It takes the place
-- of the built-in value from that date on; built-in values ship with the app.
CREATE TABLE rule_value (
    id TEXT NOT NULL PRIMARY KEY,
    rule_key TEXT NOT NULL,
    province TEXT,
    effective_from TEXT NOT NULL,
    value TEXT NOT NULL,
    note TEXT,
    created_by TEXT,
    created_at INTEGER NOT NULL
);

CREATE INDEX rule_value_key ON rule_value(rule_key, effective_from);

ruleValues:
SELECT * FROM rule_value ORDER BY rule_key, effective_from, created_at;

insertRuleValue:
INSERT INTO rule_value(id, rule_key, province, effective_from, value, note, created_by, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteRuleValue:
DELETE FROM rule_value WHERE id = ?;
