-- Version 3 to 4 (SYNC-02, SYNC-03, SYNC-07, SYNC-08): paired phones and the items they sent.
-- Paired phones (SYNC-03, SYNC-07, SYNC-08). The pair key is stored here, inside the encrypted core.db.
CREATE TABLE sync_device (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    public_key TEXT NOT NULL,
    pair_key TEXT NOT NULL,
    -- The household user the phone captures for (HH-12), and the group its documents go to.
    user_id TEXT NOT NULL,
    group_id TEXT,
    paired_at INTEGER NOT NULL,
    last_seen INTEGER,
    items_received INTEGER NOT NULL DEFAULT 0,
    revoked_at INTEGER
);

-- SYNC-02: every item received, so one sent twice is acknowledged but imported once.
CREATE TABLE sync_item (
    item_id TEXT NOT NULL PRIMARY KEY,
    device_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    received_at INTEGER NOT NULL,
    document_id TEXT,
    status TEXT NOT NULL
);
