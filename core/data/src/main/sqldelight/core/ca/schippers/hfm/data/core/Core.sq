-- Core database: household-wide data every signed-in user can open.
-- Amounts never appear here; they live in the ledger partitions.

CREATE TABLE household (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    base_currency TEXT NOT NULL DEFAULT 'CAD',
    default_locale TEXT NOT NULL DEFAULT 'fr-CA',
    created_at INTEGER NOT NULL,
    -- PROV-01: the province or territory whose rules apply (bank holidays, grants, tax forms).
    province TEXT NOT NULL DEFAULT 'QC'
);

-- People in the household (HH-01): owners of accounts, patients, plan members.
CREATE TABLE member (
    id TEXT NOT NULL PRIMARY KEY,
    display_name TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('ADULT', 'CHILD', 'DEPENDANT')),
    birth_date TEXT,
    archived INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    -- PROV-01: a person who lives or files elsewhere than the household; null means the household's.
    province TEXT
);

-- PET-01, PET-02: pets in the household. Records that name a person (health, calendar,
-- transactions) can name a pet by its id instead.
CREATE TABLE pet (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    species TEXT NOT NULL CHECK (species IN ('DOG', 'CAT', 'BIRD', 'FISH', 'RABBIT', 'RODENT', 'REPTILE', 'HORSE', 'OTHER')),
    breed TEXT,
    sex TEXT CHECK (sex IN ('MALE', 'FEMALE')),
    birth_date TEXT,
    birth_date_estimated INTEGER NOT NULL DEFAULT 0,
    colour TEXT,
    microchip TEXT,
    neutered INTEGER NOT NULL DEFAULT 0,
    licence_number TEXT,
    licence_municipality TEXT,
    licence_expiry TEXT,
    insurer TEXT,
    policy_number TEXT,
    insurance_renewal TEXT,
    owner_member_id TEXT,
    notes TEXT,
    archived INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Paired phones (SYNC-03, SYNC-07, SYNC-08). The pair key is stored here, inside the encrypted core.db.
CREATE TABLE sync_device (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    public_key TEXT NOT NULL,
    pair_key TEXT NOT NULL,
    -- The household user the phone captures for (HH-12), and the group its documents go to.
    user_id TEXT NOT NULL,
    group_id TEXT,
    paired_at INTEGER NOT NULL,
    last_seen INTEGER,
    items_received INTEGER NOT NULL DEFAULT 0,
    revoked_at INTEGER
);

-- SYNC-02: every item received, so one sent twice is acknowledged but imported once.
CREATE TABLE sync_item (
    item_id TEXT NOT NULL PRIMARY KEY,
    device_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    received_at INTEGER NOT NULL,
    document_id TEXT,
    status TEXT NOT NULL
);

-- Sign-in accounts (HH-05, HH-06). Keys and password material live in household.json.
CREATE TABLE app_user (
    id TEXT NOT NULL PRIMARY KEY,
    login_name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    display_name TEXT NOT NULL,
    role TEXT NOT NULL CHECK (role IN ('ADMINISTRATOR', 'MEMBER', 'VIEWER')),
    member_id TEXT REFERENCES member(id),
    -- Copy of the public key in household.json, protected by the database's authentication,
    -- so a tampered header cannot redirect key grants to another key.
    public_key BLOB NOT NULL,
    preferred_locale TEXT,
    active INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL
);

-- Account groups (HH-07). Each group's data is stored in its own encrypted ledger partition.
CREATE TABLE account_group (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    partition_id TEXT NOT NULL UNIQUE,
    owner_user_id TEXT REFERENCES app_user(id),
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

CREATE TABLE group_permission (
    group_id TEXT NOT NULL REFERENCES account_group(id) ON DELETE CASCADE,
    user_id TEXT NOT NULL REFERENCES app_user(id) ON DELETE CASCADE,
    level TEXT NOT NULL CHECK (level IN ('NONE', 'VIEW', 'CAPTURE_ONLY', 'EDIT')),
    PRIMARY KEY (group_id, user_id)
);

CREATE TABLE institution (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    branch TEXT,
    institution_number TEXT,
    transit_number TEXT,
    website TEXT,
    phone TEXT,
    notes TEXT,
    created_at INTEGER NOT NULL
);

-- Bilingual category tree (CAT-01), any depth.
CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    parent_id TEXT REFERENCES category(id),
    -- Stable key of a built-in category (e.g. "health.pharmacy"); null for user-created ones.
    system_key TEXT UNIQUE,
    name_en TEXT NOT NULL,
    name_fr TEXT NOT NULL,
    kind TEXT NOT NULL CHECK (kind IN ('EXPENSE', 'INCOME')),
    tax_flag TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    archived INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX category_parent ON category(parent_id);

CREATE TABLE payee (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    default_category_id TEXT REFERENCES category(id),
    address TEXT,
    phone TEXT,
    website TEXT,
    notes TEXT,
    archived INTEGER NOT NULL DEFAULT 0
);

-- Aliases map statement text to a clean payee (section 7.4).
CREATE TABLE payee_alias (
    id TEXT NOT NULL PRIMARY KEY,
    payee_id TEXT NOT NULL REFERENCES payee(id) ON DELETE CASCADE,
    pattern TEXT NOT NULL
);

CREATE TABLE tag (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE
);

-- CAT-02: "if the payee contains X (and the amount is between Y and Z), use category C".
CREATE TABLE category_rule (
    id TEXT NOT NULL PRIMARY KEY,
    payee_contains TEXT NOT NULL,
    -- Optional amount condition on the absolute amount, in minor units of [currency].
    amount_min_minor INTEGER,
    amount_max_minor INTEGER,
    currency TEXT,
    category_id TEXT NOT NULL REFERENCES category(id),
    -- Optionally rename the payee too.
    payee_id TEXT REFERENCES payee(id),
    sort_order INTEGER NOT NULL DEFAULT 0
);

-- FX-02: daily exchange rates, in Canadian dollars per unit of the currency.
CREATE TABLE fx_rate (
    currency TEXT NOT NULL,
    date TEXT NOT NULL,
    cad_per_unit TEXT NOT NULL,
    -- BOC: Bank of Canada; OPEN: the optional second source (FX-08); MANUAL: entered by the user;
    -- MARKET: a crypto-asset's price in CAD from the optional market data download (CR-05).
    source TEXT NOT NULL CHECK (source IN ('BOC', 'OPEN', 'MANUAL', 'MARKET')),
    PRIMARY KEY (currency, date)
);

-- PM-02: precious metal spot prices in CAD per troy ounce of pure metal, downloaded or entered.
CREATE TABLE spot_price (
    metal TEXT NOT NULL CHECK (metal IN ('GOLD', 'SILVER', 'PLATINUM', 'PALLADIUM')),
    date TEXT NOT NULL,
    cad_per_oz TEXT NOT NULL,
    source TEXT NOT NULL CHECK (source IN ('MARKET', 'MANUAL')),
    PRIMARY KEY (metal, date)
);

-- BUD-01: a monthly or annual budget per category, optionally rolling unspent amounts forward.
CREATE TABLE budget (
    id TEXT NOT NULL PRIMARY KEY,
    category_id TEXT NOT NULL UNIQUE REFERENCES category(id) ON DELETE CASCADE,
    period TEXT NOT NULL CHECK (period IN ('MONTHLY', 'ANNUAL')),
    amount_minor INTEGER NOT NULL,
    currency TEXT NOT NULL,
    rollover INTEGER NOT NULL DEFAULT 0,
    -- First month (YYYY-MM) the budget applies to; rollover counts from here.
    start_month TEXT NOT NULL
);

CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- Activity log (HH-13) for household-level changes. Ledger changes are logged in each ledger.
CREATE TABLE audit_log (
    id TEXT NOT NULL PRIMARY KEY,
    at INTEGER NOT NULL,
    user_id TEXT,
    action TEXT NOT NULL,
    entity TEXT NOT NULL,
    entity_id TEXT,
    details TEXT
);

CREATE INDEX audit_log_at ON audit_log(at);

insertHousehold:
INSERT INTO household(id, name, base_currency, default_locale, created_at, province) VALUES (?, ?, ?, ?, ?, ?);

setHouseholdProvince:
UPDATE household SET province = ?;

household:
SELECT * FROM household LIMIT 1;

insertUser:
INSERT INTO app_user(id, login_name, display_name, role, member_id, public_key, preferred_locale, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

userById:
SELECT * FROM app_user WHERE id = ?;

users:
SELECT * FROM app_user ORDER BY display_name;

insertMember:
INSERT INTO member(id, display_name, kind, birth_date, created_at) VALUES (?, ?, ?, ?, ?);

updateMember:
UPDATE member SET display_name = ?, kind = ?, birth_date = ?, archived = ? WHERE id = ?;

setMemberProvince:
UPDATE member SET province = ? WHERE id = ?;

members:
SELECT * FROM member ORDER BY archived, display_name;

linkUserToMember:
UPDATE app_user SET member_id = ? WHERE id = ?;

setUserRole:
UPDATE app_user SET role = ? WHERE id = ?;

setUserActive:
UPDATE app_user SET active = ? WHERE id = ?;

renameUser:
UPDATE app_user SET display_name = ? WHERE id = ?;

-- Institutions (ACC-01) --------------------------------------------------------------------

insertInstitution:
INSERT INTO institution(id, name, branch, institution_number, transit_number, website, phone, notes, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateInstitution:
UPDATE institution SET name = ?, branch = ?, institution_number = ?, transit_number = ?, website = ?, phone = ?, notes = ?
WHERE id = ?;

institutions:
SELECT * FROM institution ORDER BY name COLLATE NOCASE;

-- Categories (CAT-01) ------------------------------------------------------------------------

insertCategory:
INSERT INTO category(id, parent_id, system_key, name_en, name_fr, kind, tax_flag, sort_order)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateCategory:
UPDATE category SET parent_id = ?, name_en = ?, name_fr = ?, tax_flag = ?, sort_order = ?, archived = ? WHERE id = ?;

categories:
SELECT * FROM category ORDER BY kind, sort_order, name_en;

categoryCount:
SELECT count(*) FROM category;

-- Only categories that nothing refers to may be deleted.
deleteCategory:
DELETE FROM category WHERE id = ?;

-- Payees (section 7.4) -----------------------------------------------------------------------

insertPayee:
INSERT INTO payee(id, name, default_category_id) VALUES (?, ?, ?);

updatePayee:
UPDATE payee SET name = ?, default_category_id = ?, archived = ? WHERE id = ?;

payees:
SELECT * FROM payee ORDER BY name COLLATE NOCASE;

payeeByName:
SELECT * FROM payee WHERE name = ? COLLATE NOCASE LIMIT 1;

insertPayeeAlias:
INSERT INTO payee_alias(id, payee_id, pattern) VALUES (?, ?, ?);

payeeAliases:
SELECT * FROM payee_alias;

-- Tags (CAT-04) ------------------------------------------------------------------------------

insertTag:
INSERT OR IGNORE INTO tag(id, name) VALUES (?, ?);

tags:
SELECT * FROM tag ORDER BY name COLLATE NOCASE;

tagByName:
SELECT * FROM tag WHERE name = ? COLLATE NOCASE;

insertGroup:
INSERT INTO account_group(id, name, partition_id, owner_user_id, sort_order, created_at) VALUES (?, ?, ?, ?, ?, ?);

groups:
SELECT * FROM account_group ORDER BY sort_order, name;

setPermission:
INSERT OR REPLACE INTO group_permission(group_id, user_id, level) VALUES (?, ?, ?);

permissionsForGroup:
SELECT * FROM group_permission WHERE group_id = ?;

putSetting:
INSERT OR REPLACE INTO setting(key, value) VALUES (?, ?);

getSetting:
SELECT value FROM setting WHERE key = ?;

insertAudit:
INSERT INTO audit_log(id, at, user_id, action, entity, entity_id, details) VALUES (?, ?, ?, ?, ?, ?, ?);

recentAudit:
SELECT * FROM audit_log ORDER BY at DESC LIMIT ?;

-- HH-13: the activity of one user, or of everyone.
auditFor:
SELECT * FROM audit_log WHERE (:user IS NULL OR user_id = :user) ORDER BY at DESC LIMIT :limit;

-- Category rules (CAT-02) -------------------------------------------------------------------

insertRule:
INSERT INTO category_rule(id, payee_contains, amount_min_minor, amount_max_minor, currency, category_id, payee_id, sort_order)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteRule:
DELETE FROM category_rule WHERE id = ?;

rules:
SELECT * FROM category_rule ORDER BY sort_order, payee_contains;

-- Exchange rates (FX-02) --------------------------------------------------------------------

-- Bank of Canada rates never replace a rate the user entered by hand.
insertBocRate:
INSERT INTO fx_rate(currency, date, cad_per_unit, source) VALUES (?, ?, ?, 'BOC')
ON CONFLICT(currency, date) DO UPDATE SET cad_per_unit = excluded.cad_per_unit WHERE fx_rate.source = 'BOC';

-- FX-08: the second source fills gaps only; Bank of Canada and manual rates are never replaced.
insertOpenRate:
INSERT INTO fx_rate(currency, date, cad_per_unit, source) VALUES (?, ?, ?, 'OPEN')
ON CONFLICT(currency, date) DO UPDATE SET cad_per_unit = excluded.cad_per_unit WHERE fx_rate.source = 'OPEN';

-- CR-05: market prices of crypto-assets fill gaps and refresh themselves; manual ones are never replaced.
insertMarketRate:
INSERT INTO fx_rate(currency, date, cad_per_unit, source) VALUES (?, ?, ?, 'MARKET')
ON CONFLICT(currency, date) DO UPDATE SET cad_per_unit = excluded.cad_per_unit WHERE fx_rate.source = 'MARKET';

latestMarketDate:
SELECT max(date) AS latest FROM fx_rate WHERE currency = ? AND source = 'MARKET';

putSpot:
INSERT INTO spot_price(metal, date, cad_per_oz, source) VALUES (?, ?, ?, ?)
ON CONFLICT(metal, date) DO UPDATE SET cad_per_oz = excluded.cad_per_oz, source = excluded.source
WHERE spot_price.source = 'MARKET' OR excluded.source = 'MANUAL';

spotOnOrBefore:
SELECT * FROM spot_price WHERE metal = ? AND date <= ? ORDER BY date DESC LIMIT 1;

spots:
SELECT * FROM spot_price WHERE metal = ? ORDER BY date DESC LIMIT ?;

deleteSpot:
DELETE FROM spot_price WHERE metal = ? AND date = ?;

upsertManualRate:
INSERT OR REPLACE INTO fx_rate(currency, date, cad_per_unit, source) VALUES (?, ?, ?, 'MANUAL');

deleteRate:
DELETE FROM fx_rate WHERE currency = ? AND date = ?;

rateOnOrBefore:
SELECT * FROM fx_rate WHERE currency = ? AND date <= ? ORDER BY date DESC LIMIT 1;

rateAfter:
SELECT * FROM fx_rate WHERE currency = ? AND date > ? ORDER BY date LIMIT 1;

ratesFor:
SELECT * FROM fx_rate WHERE currency = ? AND date BETWEEN ? AND ? ORDER BY date;

latestRateDate:
SELECT max(date) AS latest FROM fx_rate WHERE currency = ? AND source = 'BOC';

-- Budgets (BUD-01) --------------------------------------------------------------------------

upsertBudget:
INSERT INTO budget(id, category_id, period, amount_minor, currency, rollover, start_month) VALUES (?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(category_id) DO UPDATE SET period = excluded.period, amount_minor = excluded.amount_minor,
    currency = excluded.currency, rollover = excluded.rollover, start_month = excluded.start_month;

deleteBudget:
DELETE FROM budget WHERE category_id = ?;

budgets:
SELECT * FROM budget;

upsertPet:
INSERT OR REPLACE INTO pet(id, name, species, breed, sex, birth_date, birth_date_estimated, colour, microchip, neutered,
    licence_number, licence_municipality, licence_expiry, insurer, policy_number, insurance_renewal, owner_member_id,
    notes, archived, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

pets:
SELECT * FROM pet ORDER BY archived, name;

deletePet:
DELETE FROM pet WHERE id = ?;

insertDevice:
INSERT OR REPLACE INTO sync_device(id, name, public_key, pair_key, user_id, group_id, paired_at, last_seen, items_received, revoked_at)
VALUES (?, ?, ?, ?, ?, ?, ?, NULL, 0, NULL);

devices:
SELECT * FROM sync_device ORDER BY revoked_at IS NOT NULL, paired_at DESC;

deviceById:
SELECT * FROM sync_device WHERE id = ?;

deviceSeen:
UPDATE sync_device SET last_seen = ?, items_received = items_received + ? WHERE id = ?;

revokeDevice:
UPDATE sync_device SET revoked_at = ? WHERE id = ?;

renameDevice:
UPDATE sync_device SET name = ?, group_id = ? WHERE id = ?;

deleteDevice:
DELETE FROM sync_device WHERE id = ?;

insertSyncItem:
INSERT OR IGNORE INTO sync_item(item_id, device_id, kind, received_at, document_id, status) VALUES (?, ?, ?, ?, ?, ?);

syncItemById:
SELECT * FROM sync_item WHERE item_id = ?;

syncItemsForDevice:
SELECT * FROM sync_item WHERE device_id = ? ORDER BY received_at DESC LIMIT ?;
