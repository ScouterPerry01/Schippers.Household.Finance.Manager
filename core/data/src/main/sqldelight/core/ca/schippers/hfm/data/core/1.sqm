-- Version 1 to 2 (FX-08): exchange rates may also come from the optional second source.
-- SQLite cannot change a CHECK constraint in place, so the table is rebuilt and the rates copied.
CREATE TABLE fx_rate_v2 (
    currency TEXT NOT NULL,
    date TEXT NOT NULL,
    cad_per_unit TEXT NOT NULL,
    source TEXT NOT NULL CHECK (source IN ('BOC', 'OPEN', 'MANUAL')),
    PRIMARY KEY (currency, date)
);

INSERT INTO fx_rate_v2(currency, date, cad_per_unit, source)
SELECT currency, date, cad_per_unit, source FROM fx_rate;

DROP TABLE fx_rate;

ALTER TABLE fx_rate_v2 RENAME TO fx_rate;
