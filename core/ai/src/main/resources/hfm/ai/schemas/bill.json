{
  "$id": "hfm/bill/v3",
  "title": "bill",
  "type": "object",
  "properties": {
    "biller": {
      "type": "string",
      "description": "Company sending the bill"
    },
    "account_number": {
      "type": "string"
    },
    "statement_number": {
      "type": "string",
      "description": "Statement, bill or invoice number, as printed"
    },
    "bill_date": {
      "type": "string",
      "format": "date",
      "description": "Date the bill was issued"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "previous_balance": {
      "type": "number"
    },
    "payments_received": {
      "type": "number"
    },
    "new_charges": {
      "type": "number"
    },
    "amount_due": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 code of the amounts, such as CAD or USD"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "As printed"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "amount": {
            "type": "number",
            "description": "Line total; discounts and returns are negative"
          }
        },
        "required": [
          "description",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    "taxes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "GST",
              "HST",
              "QST",
              "PST",
              "OTHER"
            ]
          },
          "rate_percent": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    "meter_readings": {
      "type": "object",
      "description": "Utility bills only (electricity, gas, water): the meter readings the bill shows",
      "properties": {
        "previous_reading": {
          "type": "number"
        },
        "previous_reading_date": {
          "type": "string",
          "format": "date"
        },
        "current_reading": {
          "type": "number"
        },
        "current_reading_date": {
          "type": "string",
          "format": "date"
        },
        "amount_used": {
          "type": "number",
          "description": "Consumption for the period, in the unit"
        },
        "unit": {
          "type": "string",
          "enum": [
            "kWh",
            "m3",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "instalments": {
      "type": "array",
      "description": "Bills paid in instalments on set dates only (property taxes): each instalment, in date order",
      "items": {
        "type": "object",
        "properties": {
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "due_date",
          "amount"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "biller",
    "amount_due",
    "currency"
  ],
  "additionalProperties": false
}
