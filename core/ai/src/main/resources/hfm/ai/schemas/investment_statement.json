{
  "$id": "hfm/investment_statement/v2",
  "title": "investment_statement",
  "type": "object",
  "properties": {
    "institution": {
      "type": "string"
    },
    "account_number_last_digits": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "description": "Such as TFSA, RRSP, RRIF, RESP, FHSA, LIRA, LIF, margin or cash"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 code of the amounts, such as CAD or USD"
    },
    "opening_cash_balance": {
      "type": "number",
      "description": "Cash at the start of the period, if printed"
    },
    "cash_balance": {
      "type": "number"
    },
    "total_value": {
      "type": "number"
    },
    "holdings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "market_value": {
            "type": "number"
          },
          "book_value": {
            "type": "number"
          },
          "identifier": {
            "type": "string",
            "description": "CUSIP or ISIN, if printed"
          }
        },
        "required": [
          "description",
          "quantity",
          "market_value"
        ],
        "additionalProperties": false
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "settlement_date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "type": "string",
            "enum": [
              "buy",
              "sell",
              "dividend",
              "interest",
              "distribution",
              "reinvestment",
              "return_of_capital",
              "contribution",
              "withdrawal",
              "fee",
              "transfer",
              "other"
            ]
          },
          "symbol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "commission": {
            "type": "number",
            "description": "Commission and fees of a trade, always positive"
          },
          "tax_withheld": {
            "type": "number",
            "description": "Tax withheld from income, always positive"
          },
          "amount": {
            "type": "number",
            "description": "Cash effect: money in positive, money out negative"
          }
        },
        "required": [
          "date",
          "type",
          "amount"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "institution",
    "period_end",
    "holdings"
  ],
  "additionalProperties": false
}
