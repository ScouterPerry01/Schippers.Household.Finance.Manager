# Rates and rules: incometax. Format in core/calc/src/main/kotlin/ca/schippers/hfm/calc/rules/Rules.kt.
#
# The income tax estimate (ca.schippers.hfm.calc.tax.IncomeTax). Each value takes effect on January 1
# of a tax year and stays until the next one: a year whose figures are not published keeps the last.
# Every value was read on the official source named after it (CRA forms, worksheets, TD1 forms and
# T4127, Revenu Québec, Finance Canada and the provinces' finance ministries) in October 2026.
#
# BRACKETS: the rate on taxable income above each threshold. LIST values, in order:
#   bpa: the amount; or maximum; minimum; net income where the reduction starts; where it ends
#   age: maximum; net income threshold; reduction rate (Quebec: on family income, with the retirement amount)
#   spouse: maximum; the spouse's net income above which it is reduced dollar for dollar
#   medical: rate of net income; fixed amount (the lesser of the two is the threshold)
#   donation: first tier limit; its rate; the rate above; the rate on gifts matched by income in the top bracket
#   dividends: credit rates on the taxable amount of eligible and of other dividends
#   topUpCredit, supplementalCredit: credit amounts above this threshold; the extra rate on them
#   surtax: threshold; rate; threshold; rate, on the provincial tax after credits
#   lowIncomeReduction: maximum; net income threshold; reduction rate
#   healthPremium: taxable income from; rate; cap, for each tier
#   cpp, qpp: maximum employee contribution (first tier); base rate; employee rate
#   qc.workerDeduction: rate of employment income; maximum
#   qc.retirement: maximum; factor applied to the pension income
#   qc.medical: rate of family income; credit rate

rule tax.fed.brackets BRACKETS
rule tax.fed.creditRate RATE
rule tax.fed.bpa LIST
rule tax.fed.employmentAmount AMOUNT
rule tax.fed.age LIST
rule tax.fed.pension AMOUNT
rule tax.fed.donation LIST
rule tax.fed.topUpCredit LIST
rule tax.fed.quebecAbatement RATE
rule tax.cpp LIST
rule tax.qpp LIST
rule tax.prov.brackets BRACKETS province
rule tax.prov.creditRate RATE province
rule tax.prov.bpa LIST province
rule tax.prov.spouse LIST province
rule tax.prov.age LIST province
rule tax.prov.seniorSupplement AMOUNT province
rule tax.prov.employmentAmount AMOUNT province
rule tax.prov.pension AMOUNT province
rule tax.prov.medical LIST province
rule tax.prov.donation LIST province
rule tax.prov.dividends LIST province
rule tax.prov.supplementalCredit LIST province
rule tax.prov.surtax LIST province
rule tax.prov.taxReduction AMOUNT province
rule tax.prov.lowIncomeReduction LIST province
rule tax.prov.healthPremium LIST province
rule tax.qc.workerDeduction LIST
rule tax.qc.retirement LIST
rule tax.qc.medical LIST

