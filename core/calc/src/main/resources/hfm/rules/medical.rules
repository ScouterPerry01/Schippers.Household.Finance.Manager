# Rates and rules: medical. Format in core/calc/src/main/kotlin/ca/schippers/hfm/calc/rules/Rules.kt.
# Read by Medical (core/calc), TripService and the medical expenses report.

# The medical expense credit: expenses count above the lesser of this share of net income and
# the fixed amount for the year (indexed each year: a year without its own amount has none).
rule medical.threshold.rate RATE
medical.threshold.rate | - | 2000-01-01 | 0.03 | CRA, Lines 33099 and 33199: 3% of net income or the fixed amount, whichever is less
rule medical.threshold.max AMOUNT
medical.threshold.max | - | 2023-01-01 | 2635 | CRA, Adjustment of the personal income tax and benefit amounts: medical expense tax credit (3% of net income ceiling), 2023
medical.threshold.max | - | 2024-01-01 | 2759 | CRA, Adjustment of the personal income tax and benefit amounts: medical expense tax credit (3% of net income ceiling), 2024
medical.threshold.max | - | 2025-01-01 | 2834 | CRA, Adjustment of the personal income tax and benefit amounts: medical expense tax credit (3% of net income ceiling), 2025
medical.threshold.max | - | 2026-01-01 | 2890 | CRA, Adjustment of the personal income tax and benefit amounts: medical expense tax credit (3% of net income ceiling), 2026

# Medical travel: the care must be at least this many kilometres away, one way, to claim the
# cost of travel by car.
rule medical.travel.min.km NUMBER
medical.travel.min.km | - | 2000-01-01 | 40 | CRA, Lines 33099 and 33199: travel expenses, at least 40 km (one way) from home

# The simplified method: dollars per kilometre for the province or territory where the travel
# begins, by tax year. The CRA publishes a year early in the next; until then the last applies.
rule medical.travel.rate AMOUNT province
medical.travel.rate | AB | 2023-01-01 | 0.53 | CRA, Meal and vehicle rates used to calculate travel expenses (2023 kilometre rates, 53.0 cents/km)
medical.travel.rate | BC | 2023-01-01 | 0.565 | CRA, Meal and vehicle rates used to calculate travel expenses (2023 kilometre rates, 56.5 cents/km)
