<Project Sdk="Microsoft.NET.Sdk">

  <!--
    hfm-hello: tiny Windows Hello helper for the Household Finance Manager (spike for SEC-02).
    The Windows TFM pulls in the C#/WinRT projection (Microsoft.Windows.SDK.NET) so we can use
    Windows.Security.Credentials.* directly from an unpackaged desktop exe.

    Build (NativeAOT, single native exe, no .NET runtime needed on the target):
      dotnet publish -c Release -r win-x64
    Output: bin/Release/net10.0-windows10.0.19041.0/win-x64/publish/hfm-hello.exe
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>hfm-hello</AssemblyName>
    <RootNamespace>HfmHello</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- NativeAOT: one self-contained native exe, fast startup (matters: the JVM spawns it per unlock). -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <!-- CsWinRT AOT support (generated vtables for the generic WinRT interfaces we use). -->
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
  </PropertyGroup>

</Project>
